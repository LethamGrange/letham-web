<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap"
      rel="stylesheet"
      webc:keep
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
      webc:keep
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
      rel="stylesheet"
      webc:keep
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Letham Grange Curling" />
    <title @text="title ?? 'Letham Grange'"></title>

    <!-- 1. CRUCIAL: Establish layer order explicitly in raw HTML -->
    <style webc:keep>
      @layer openprops, theme, normalize, custom.reset, custom.base, components.root, components.extended, utils;
    </style>
    <link rel="stylesheet" href="/css/main.css" webc:keep />

    <!-- this produces the bundled component css needed for the particular page so will be optimized and small-->

    <link rel="stylesheet" :href="getBundleFileUrl('css' )" webc:keep />

    <link
      webc:if="$data.componentBucket"
      webc:keep
      rel="stylesheet"
      :href="getBundleFileUrl('css', $data.componentBucket)"
    />

    <style
      webc:if="$data.pageBucket"
      @raw="getBundle('css', $data.pageBucket)"
      webc:keep
    ></style>

    <!-- Critical inline initialization to prevent dark-mode page flash -->
    <script webc:keep>
      const savedTheme = localStorage.getItem("theme-preference");

      // FIXED: If prefers-color-scheme is dark, default to dark; otherwise light.
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";

      document.documentElement.setAttribute(
        "data-theme",
        savedTheme || systemTheme,
      );
    </script>
  </head>

  <body tabindex="-1" class="site-wrapper">
    <header>
      <page-header
        webc:if="$data.headerImage"
        :@pos="$data.headerPosition"
        :@title="$data.pagetitle"
        :@description="$data.description"
        :@image="$data.headerImage"
        :@alt="$data.headerAlt || 'Section header graphic'"
      >
      </page-header>
      <site-nav></site-nav>
    </header>

    <main class="page-layout">
      <template webc:nokeep @raw="content"></template>
    </main>
    <site-footer></site-footer>
    <script :src="getBundleFileUrl('js')" webc:keep></script>
  </body>

  <script
    src="https://unpkg.com/htmx.org@1.9.12"
    integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2"
    crossorigin="anonymous"
    webc:keep
  ></script>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    webc:keep
  ></script>
</html>
