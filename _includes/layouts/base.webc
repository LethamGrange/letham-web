<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap"
      rel="stylesheet"
      webc:keep
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
      webc:keep
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
      rel="stylesheet"
      webc:keep
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Letham Grange Curling" />
    <title @text="title ?? 'Letham Grange'"></title>

    <!-- 1. CRUCIAL: Establish layer order explicitly in raw HTML -->
    <style webc:keep>
      @layer openprops, theme, normalize, custom.reset, custom.base, components.root, components.extended, components.features utils;
    </style>
    <link rel="stylesheet" href="/css/main.css" webc:keep />

    <!-- this produces the bundled component css needed for the particular page so will be optimized and small-->

    <link rel="stylesheet" :href="getBundleFileUrl('css' )" webc:keep />

    <link
      webc:if="$data.componentBucket"
      webc:keep
      rel="stylesheet"
      :href="getBundleFileUrl('css', $data.componentBucket)"
    />

    <style
      webc:if="$data.pageBucket"
      @raw="getBundle('css', $data.pageBucket)"
      webc:keep
    ></style>

    <!-- WebC injects the dynamically generated JSON directly into the template -->
    <script type="importmap" webc:keep>
      {
        "imports": {
          "js/": "/js/"
        }
      }
    </script>
    <!-- Critical inline initialization to prevent dark-mode page flash -->
    <script webc:keep>
      const savedTheme = localStorage.getItem("theme-preference");

      // FIXED: If prefers-color-scheme is dark, default to dark; otherwise light.
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";

      document.documentElement.setAttribute(
        "data-theme",
        savedTheme || systemTheme,
      );
    </script>

    <script
      async
      src="https://unpkg.com/es-module-shims@1.3.0/dist/es-module-shims.js"
      webc:keep
    ></script>
  </head>

  <body tabindex="-1" class="site-wrapper">
    <header>
      <page-header
        webc:if="$data.headerImage"
        :@pos="$data.headerPosition"
        :@title="$data.pagetitle"
        :@description="$data.description"
        :@image="$data.headerImage"
        :@alt="$data.headerAlt || 'Section header graphic'"
      >
      </page-header>
      <site-nav></site-nav>
    </header>

    <main class="page-layout">
      <template webc:nokeep @raw="content"></template>
    </main>
    <site-footer></site-footer>
    <script
      :src="getBundleFileUrl('js', 'base-js')"
      webc:keep
      type="module"
    ></script>
    <script :src="getBundleFileUrl('js')" webc:keep type="module"></script>
  </body>
  <script
    src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js"
    integrity="sha384-6lyVbhrs13b9z7mLOpt/N6R76rtkEBWgCjAXRs/DSWyi2AMnQSs10ijWk+PI8n7W"
    crossorigin="anonymous"
    i
    webc:keep
  ></script>
  <script webc:keep>
    htmx.config.implicitInheritance = false;
    htmx.config.noSwap = [204, 304, "4xx", "5xx"];
  </script>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    webc:keep
  ></script>

  <script>
    (function () {
      const match = document.cookie.match(/(^| )user_role=([^;]+)/);
      const role = match ? match[2].trim() : "guest";
      document.body.setAttribute("data-user-role", role);
    })();
  </script>
</html>
