<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
      rel="stylesheet"
      webc:keep
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Letham Grange Curling" />
    <title @text="title ?? 'Letham Grange'"></title>
    <!-- 1. CRUCIAL: Establish layer order explicitly in raw HTML -->
    <style webc:keep>
      @layer openprops, theme, normalize, components.root, components.extended, utils;
    </style>

    <style webc:type="scss" webc:bucket="main">
      @import "../../src/css/main.scss";
    </style>

    <!-- This single line writes out your entire main.scss layout AND any tiny component <style> blocks -->
    <style
      webc:keep
      @raw="`@import url(${getBundleFileUrl('css','main')});`"
    ></style>
    <style webc:keep @raw="`@import url(${getBundleFileUrl('css')});`"></style>
    <!-- Critical inline initialization to prevent dark-mode page flash -->
    <script>
      const savedTheme = localStorage.getItem("theme-preference");

      // FIXED: If prefers-color-scheme is dark, default to dark; otherwise light.
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";

      document.documentElement.setAttribute(
        "data-theme",
        savedTheme || systemTheme,
      );
    </script>
  </head>

  <body tabindex="-1" class="site-wrapper">
    <page-title
      webc:if="$data.pagetitle"
      :@title="$data.pagetitle"
      :@src="$data.pagesrc"
    ></page-title>
    <site-header></site-header>

    <!-- This main tag acts as the smart layout grid -->
    <main class="page-layout">
      <template webc:type="11ty" 11ty:type="liquid"> {{ content }} </template>
    </main>

    <footer>
      <p>&copy; Letham Grange Curling Club</p>
    </footer>

    <script :src="getBundleFileUrl('js')" webc:keep></script>
  </body>
</html>

<style webc:type="scss">
  /* Seamless full-window vertical stack */
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /*
     This acts as our master layout grid.
     We move the top/bottom vertical breathing room safety padding here,
     leaving the left and right completely free for full-width elements!
  */
  .page-layout {
    flex: 1;
    padding-block: var(
      --size-6
    ); /* Comfortable vertical spacing above and below content */
  }

  .site-footer {
    margin-top: auto; /* Absolute guarantee that footer stays at screen bottom */
  }
</style>
