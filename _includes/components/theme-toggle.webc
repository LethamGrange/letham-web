<button
  id="theme-toggle"
  class="theme-toggle"
  title="Toggle dark and light mode"
  aria-live="polite"
  webc:root="override"
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24">
    <!-- 1. DEFINE THE SHARP 50/50 SPLIT GRADIENT NATIVELY -->
    <defs>
      <linearGradient id="split-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <!-- Current color fills the left half -->
        <stop offset="50%" stop-color="currentColor" />
        <!-- Right half stays completely empty/see-through -->
        <stop offset="50%" stop-color="transparent" />
      </linearGradient>
    </defs>

    <!-- 2. APPLY THE GRADIENT CHANNELS -->
    <circle class="contrast-icon" cx="12" cy="12" r="10" />
  </svg>
</button>

<script>
  // Your exact execution logic stays here unchanged because it works perfectly!
  const getColorPreference = () => {
    if (localStorage.getItem("theme-preference")) {
      return localStorage.getItem("theme-preference");
    } else {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
  };

  const setPreference = () => {
    localStorage.setItem("theme-preference", theme.value);
    reflectPreference();
  };

  const reflectPreference = () => {
    document.firstElementChild.setAttribute("data-theme", theme.value);
    document
      .querySelector("#theme-toggle")
      ?.setAttribute("aria-label", theme.value);
  };

  const theme = { value: getColorPreference() };
  reflectPreference();

  document.addEventListener("DOMContentLoaded", () => {
    reflectPreference();
    const btn = document.querySelector("#theme-toggle");
    if (!btn) return;

    let currentTheme = document.documentElement.getAttribute("data-theme");
    btn.setAttribute("aria-label", currentTheme);

    btn.addEventListener("click", () => {
      const nextTheme = currentTheme === "light" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", nextTheme);
      localStorage.setItem("theme-preference", nextTheme);
      btn.setAttribute("aria-label", nextTheme);
      currentTheme = nextTheme;
    });
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", ({ matches: isDark }) => {
      theme.value = isDark ? "dark" : "light";
      setPreference();
    });
</script>

<style>
  :where(.theme-toggle) {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-round);
    transition: background-color 0.2s ease;

    /* Feeds your precise high-contrast header link color right down into the SVG's 'currentColor' channel */
    color: var(--_accent-contrast, var(--gray-0));
    --_hover-color: rgba(255, 255, 255, 0.1);
  }

  :where(.theme-toggle):hover {
    background-color: var(--_hover-color);
  }

  /* 3. SIMPLIFIED BULLETPROOF SVG STYLING */
  .contrast-icon {
    /* Reference the internal SVG definitions URL block */
    fill: url(#split-gradient);
    stroke: currentColor;
    stroke-width: 2px;

    transform-origin: center;
    transition: transform 0.5s var(--ease-elastic-out-3);
  }

  /* Spin the half-filled moon disc elegantly on click updates */
  [data-theme="dark"] .contrast-icon {
    transform: rotate(180deg);
  }
</style>
