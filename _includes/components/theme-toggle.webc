<button
  id="theme-toggle-btn"
  class="theme-toggle"
  title="Toggle dark and light mode"
  aria-live="polite"
  webc:root="override"
>
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24">
    <!-- 1. DEFINE THE SHARP 50/50 SPLIT GRADIENT NATIVELY -->
    <defs>
      <linearGradient id="split-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <!-- Current color fills the left half -->
        <stop offset="50%" stop-color="currentColor" />
        <!-- Right half stays completely empty/see-through -->
        <stop offset="50%" stop-color="transparent" />
      </linearGradient>
    </defs>

    <!-- 2. APPLY THE GRADIENT CHANNELS -->
    <circle class="contrast-icon" cx="12" cy="12" r="10" />
  </svg>
</button>

<script>
  // Read the live theme directly from the DOM state established in the <head>
  const curTheme = {
    value: document.documentElement.getAttribute("data-theme"),
  };

  // The single source of truth for themes
  const getThemePair = (theme) =>
    theme === "dark" ? ["dark", "light"] : ["light", "dark"];

  const applyThemePair = (theme, nextTheme, btn, shouldSave = false) => {
    document.documentElement.setAttribute("data-theme", theme);
    btn.setAttribute("aria-label", `Switch to ${nextTheme} theme.`);

    if (shouldSave) {
      localStorage.setItem("theme-preference", theme);
    }

    return theme;
  };

  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector("#theme-toggle-btn");
    if (!btn) return;

    // Sync the aria-labels to match the theme applied by the <head>
    const [theme, nextTheme] = getThemePair(curTheme.value);
    applyThemePair(theme, nextTheme, btn, false);

    btn.addEventListener("click", () => {
      const [currentTheme, nextTheme] = getThemePair(curTheme.value);
      const svtFn = () =>
        (curTheme.value = applyThemePair(nextTheme, currentTheme, btn, true));

      document.startViewTransition?.(svtFn) ?? svtFn();
    });
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", ({ matches: isDark }) => {
      // Stop system overrides if the user explicitly locked in a preference
      if (localStorage.getItem("theme-preference")) return;

      curTheme.value = isDark ? "dark" : "light";
      const btn = document.querySelector("#theme-toggle-btn");

      if (btn) {
        const [theme, nextTheme] = getThemePair(curTheme.value);
        applyThemePair(theme, nextTheme, btn, false);
      }
    });
</script>

<style>
  :where(.theme-toggle) {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-round);
    transition: background-color 0.2s ease;

    /* Feeds your precise high-contrast header link color right down into the SVG's 'currentColor' channel */
    color: var(--_accent-contrast, var(--gray-0));
    --_hover-color: rgba(255, 255, 255, 0.1);
  }

  :where(.theme-toggle):hover {
    background-color: var(--_hover-color);
  }

  /* 3. SIMPLIFIED BULLETPROOF SVG STYLING */
  .contrast-icon {
    /* Reference the internal SVG definitions URL block */
    fill: url(#split-gradient);
    stroke: currentColor;
    stroke-width: 2px;

    transform-origin: center;
    transition: transform 0.5s var(--ease-elastic-out-3);
  }

  /* Spin the half-filled moon disc elegantly on click updates */
  [data-theme="dark"] .contrast-icon {
    transform: rotate(180deg);
  }
</style>
