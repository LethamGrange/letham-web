<!-- 1. GLOBAL NAV LANE (Heavy, elevated structure) -->
<nav class="navigation-lane global-lane" webc:root="override">
  <button
    class="ui-button top menu-toggle-btn menu-button"
    commandfor="drawer-inline-start-html"
    command="show-modal"
    aria-haspopup="dialog"
    aria-controls="drawer-inline-start-html"
  >
    <svg
      class="hamburger-icon"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      stroke="currentColor"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line class="line-top" x1="3" y1="12" x2="21" y2="12"></line>
      <line class="line-mid" x1="3" y1="6" x2="21" y2="6"></line>
      <line class="line-bot" x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <!-- Pass tier="global" down to isolate data parsing -->
  <nav-links :@tier="'global'"></nav-links>
  <theme-toggle></theme-toggle>
</nav>

<!-- 2. CONTEXT NAV LANE (Light, flat child layout) -->
<!-- Only renders if context navigation items exist in the data cascade -->
<nav
  class="navigation-lane context-lane"
  webc:if="$data.contextNavigation && $data.contextNavigation.length > 0"
>
  <nav-links :@tier="'context'"></nav-links>
</nav>

<!-- MOBILE DRAWER (For top-level global links only) -->
<dialog
  class="ui-drawer ui-scroll-lock ui-inline-start"
  id="drawer-inline-start-html"
  closedby="any"
>
  <div class="ui-header">
    <span>Menu</span>
    <button
      class="ui-icon-button"
      title="Close"
      onclick="this.closest('dialog').close()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
        />
      </svg>
    </button>
  </div>
  <div class="ui-content">
    <nav class="mobile-only-menu">
      <nav-links :@tier="'global'"></nav-links>
    </nav>
  </div>
  <div class="ui-footer">
    <button
      class="ui-button ui-small"
      commandfor="drawer-inline-start-html"
      command="close"
    >
      Close
    </button>
  </div>
</dialog>

<style>
  /* Base structural lanes */
  :where(.navigation-lane) {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    padding-inline: var(--size-fluid-3);
    /* Ensure a reliable uniform height layer so absolute items line up cleanly */
    min-height: var(--size-9);
  }

  /* --- TIER 1: GLOBAL LANE VISUAL WEIGHTS --- */
  .global-lane {
    /* This lets us center the nav-links box directly against the screen edges */
    justify-content: center;
    background-color: light-dark(var(--primary), var(--surface-filled));
    color: light-dark(var(--primary-contrast), var(--text-primary));
    box-shadow: var(--shadow-2);
    z-index: var(--layer-3);
  }

  /* Ensure the central desktop link box stretches smoothly */
  .global-lane .nav-links {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* --- ABSOLUTE EDGE POSITIONING --- */

  /* Pull the hamburger menu toggle to the absolute left flank */
  .global-lane .menu-toggle-btn {
    position: absolute;
    left: var(--size-fluid-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-4);
  }

  /* Pull your theme toggle component button to the absolute right flank */
  .global-lane .theme-toggle {
    position: absolute;
    right: var(--size-fluid-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-4);

    /* Fallback color fixes for dark mode surface visibility profiles */
    color: inherit;
    --_hover-color: light-dark(
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.05)
    );
  }
  /* --- TIER 2: CONTEXT LANE VISUAL WEIGHTS --- */
  .context-lane {
    justify-content: center;
    background-color: light-dark(
      var(--color-4),
      var(--color-13)
    ); /* Matches standard layout surface */
    color: var(--text-primary);
    border-block-end: 1px solid var(--border-dim); /* Flat divider strip instead of shadow */
    z-index: var(--layer-2);
  }

  /* Shared formatting and layout properties */
  .menu-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    color: inherit;
  }

  /* Desktop Defaults */
  .nav-links {
    display: flex;
    flex-direction: row;
    gap: var(--size-5);
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    padding-block: var(--size-2);
    transition: opacity 0.2s ease;
  }

  /* Distinct Tier Active Styling */
  .global-lane .nav-links a {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-6);
  }
  .global-lane .nav-links a.active {
    color: light-dark(var(--primary-contrast), var(--primary));
    font-weight: var(--font-weight-7);
    text-decoration: underline;
    text-underline-offset: var(--size-1);
  }

  .context-lane .nav-links a {
    font-size: var(--font-size-1); /* Scaled down sub-links */
    font-weight: var(--font-weight-4);
    /* Generous horizontal area for easy clicking, keeping it slim vertically */
    padding-block: var(--size-1); /* Slim top/bottom padding */
    padding-inline: var(--size-3); /* Wider side padding */
  }
  .context-lane .nav-links a.active {
    color: var(--primary);
    font-weight: var(--font-weight-6);
    border-bottom: 2px solid var(--primary); /* Tab style active layout marker instead */
  }

  .nav-links a:hover {
    opacity: 0.8;
  }

  /* Open Props Drawer Custom Formatting override styles */
  dialog.ui-drawer {
    background-color: var(--surface-default);

    .nav-links {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
      padding: var(--size-5);
      width: 100%;
      background: none;
    }

    .nav-links a {
      color: var(--text-primary);
      font-size: var(--font-size-2);
    }

    .nav-links a.active {
      color: var(--primary);
      text-decoration: underline;
    }
  }

  /* Responsive Display Rules */
  @media (min-width: 768px) {
    .menu-toggle-btn {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    /* Hide the global header layout row items on small mobile screens */
    .global-lane .nav-links {
      display: none !important;
    }

    /* Transform Context Lane into a clean horizontal swiping tray on mobile */
    .context-lane {
      justify-content: flex-start;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none; /* Hide standard ugly scrollbar tracking */
      -webkit-overflow-scrolling: touch;
      padding-inline: var(--size-3);
    }
    .context-lane::-webkit-scrollbar {
      display: none;
    }
    .context-lane .nav-links {
      gap: var(--size-4);
    }
  }
</style>
