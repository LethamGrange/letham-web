<!-- 1. GLOBAL NAV LANE (Heavy, elevated structure) -->
<nav class="navigation-lane global-lane" webc:root="override">
  <button
    class="ui-button top menu-toggle-btn menu-button"
    commandfor="drawer-inline-start-html"
    command="show-modal"
    aria-haspopup="dialog"
    aria-controls="drawer-inline-start-html"
    aria-label="Open navigation menu"
  >
    <svg
      class="hamburger-icon"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      stroke="currentColor"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line class="line-top" x1="3" y1="12" x2="21" y2="12"></line>
      <line class="line-mid" x1="3" y1="6" x2="21" y2="6"></line>
      <line class="line-bot" x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <!-- Pass tier="global" down to isolate data parsing -->
  <nav-links :@tier="'global'"></nav-links>
  <theme-toggle></theme-toggle>
</nav>
<!-- CONTEXT NAV LANE -->
<nav
  class="navigation-lane context-lane"
  webc:if="$data.contextNavigation?.length > 0 || $data.collections.autoContext?.[$data.page.url.split('/').filter(Boolean)[0]]?.length > 0"
>
  <nav-links
    :@tier="'context'"
    :@custom-links="$data.collections.autoContext?.[$data.page.url.split('/').filter(Boolean)[0]]"
  ></nav-links>
</nav>

<!-- MOBILE DRAWER (For top-level global links only) -->

<dialog
  class="ui-drawer ui-scroll-lock ui-inline-start"
  id="drawer-inline-start-html"
  closedby="any"
>
  <div class="ui-header">
    <!-- Reads straight out of your 11ty global site metadata json file -->
    <span @text="$data.site?.name">Westmuir</span>

    <button
      class="ui-icon-button"
      title="Close"
      onclick="this.closest('dialog').close()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
        />
      </svg>
    </button>
  </div>
  <div class="ui-content">
    <nav class="mobile-only-menu">
      <nav-links :@tier="'global'"></nav-links>
    </nav>
  </div>
  <div class="ui-footer">
    <button
      class="ui-button ui-small"
      commandfor="drawer-inline-start-html"
      command="close"
    >
      Close
    </button>
  </div>
</dialog>

<style>
  /* Base structural lanes */
  :where(.navigation-lane) {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    padding-inline: var(--size-fluid-3);
    /* Ensure a reliable uniform height layer so absolute items line up cleanly */
    min-height: var(--size-6);
  }

  /* --- TIER 1: GLOBAL LANE VISUAL WEIGHTS --- */
  .global-lane {
    /* This lets us center the nav-links box directly against the screen edges */
    justify-content: center;
    background-color: light-dark(var(--primary), var(--surface-filled));
    color: light-dark(var(--primary-contrast), var(--text-primary));
    box-shadow: var(--shadow-2);
    z-index: var(--layer-3);
  }

  /* Ensure the central desktop link box stretches smoothly */
  .global-lane .nav-links {
    display: flex;
    justify-content: flex-start;
    width: 100%;
  }

  /* --- ABSOLUTE EDGE POSITIONING --- */

  /* Pull the hamburger menu toggle to the absolute left flank */
  .global-lane .menu-toggle-btn {
    position: absolute;
    left: var(--size-fluid-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-4);
  }

  /* Pull your theme toggle component button to the absolute right flank */
  .global-lane .theme-toggle {
    position: absolute;
    right: var(--size-fluid-3);
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-4);

    /* Fallback color fixes for dark mode surface visibility profiles */
    color: inherit;
    --_hover-color: light-dark(
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.05)
    );
  }
  /* --- TIER 2: CONTEXT LANE VISUAL WEIGHTS --- */

  .context-lane {
    /* CHANGE THIS: Switch from center to flex-start alignment */
    justify-content: flex-start;
    background-color: light-dark(var(--color-4), var(--color-13));
    color: var(--text-primary);
    border-block-end: 1px solid var(--border-dim);
    z-index: var(--layer-2);

    /* Matches standard page margins so links line up with your main paragraphs */
    padding-inline: var(--size-fluid-3);
  }

  /* Ensure the sub-links frame stays flush left */
  .context-lane .nav-links {
    display: flex;
    justify-content: flex-start;
    width: auto;
    gap: 0; /* Reset raw gap since we are using explicit padding and dividers */
  }

  /* Base link architecture */
  .context-lane .nav-links a {
    text-decoration: none;
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-4);
    color: var(--text-primary);

    /* Generous side margins give targets clickability while maintaining slim heights */
    padding-block: var(--size-2);
    padding-inline: var(--size-3);

    /* Using a matching color instead of transparent prevents bottom border layout shifts */
    border-bottom: 2px solid transparent;

    display: inline-flex;
    align-items: center;
    position: relative;
  }

  /* 1. RESTORE BALANCED PADDING TO THE OVERVIEW LINK */
  .context-lane .nav-links a.overview-link {
    font-weight: var(--font-weight-6);
    padding-inline-start: 0; /* Keeps the main text flush left */
    padding-inline-end: var(
      --size-3
    ); /* Pushes the > safely away from the absolute edge */
    margin-inline-end: 0; /* Clear the old margin block completely */
  }

  /* 2. OPTIMIZE THE PIPE INTERACTION FOR THE FIRST ITEM */
  /* This ensures the vertical pipe sits exactly at the container edge
     without crowding the arrows or the following text links */
  .context-lane .nav-links a:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0; /* Keep it locked to the bounding edge */
    top: 25%;
    height: 50%;
    width: 1px;
    background-color: var(--color-9);
    opacity: 0.8;
  }

  /* Clean Active Borders */
  .context-lane .nav-links a.active {
    color: var(--primary);
    font-weight: var(--font-weight-6);
    text-decoration: underline;
    text-underline-offset: 0.5rem;
    text-decoration-thickness: 2px;

    /* border-bottom: 2px solid var(--primary); */
  }

  .context-lane .nav-links a:hover {
    opacity: 0.8;
  }

  /* Shared formatting and layout properties */
  .menu-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--size-2);
    color: inherit;
  }

  /* Desktop Defaults */
  .nav-links {
    display: flex;
    flex-direction: row;
    gap: var(--size-5);
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    padding-block: var(--size-2);
    transition: opacity 0.2s ease;
  }

  /* Distinct Tier Active Styling */
  .global-lane .nav-links a {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-6);
  }
  .global-lane .nav-links a.active {
    color: light-dark(var(--primary-contrast), var(--primary));
    font-weight: var(--font-weight-7);
    text-decoration: underline;
    text-underline-offset: var(--size-1);
  }

  .nav-links a:hover {
    opacity: 0.8;
  }

  /* Open Props Drawer Custom Formatting override styles */
  dialog.ui-drawer {
    background-color: var(--surface-default);

    /* 1. CLEAN HEADER RHYTHM */
    .ui-header {
      border-bottom: 1px solid var(--border-dim);
      padding-inline: var(--size-4);
      padding-block: var(--size-3);

      span {
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-7);
        letter-spacing: var(--font-letter-spacing-1);
        text-transform: uppercase;
        color: var(--text-secondary);
      }
    }

    /* 2. GLOBAL LINKS FORMATTING */
    .nav-links {
      display: flex;
      flex-direction: column;
      gap: var(--size-3);
      padding: var(--size-4);
      width: 100%;
      background: none;
    }

    .nav-links a {
      color: var(--text-primary);
      font-size: var(--font-size-2);
      font-weight: var(--font-weight-6);
      text-decoration: none;
      padding-block: var(--size-1);
    }

    .nav-links a.active {
      color: var(--primary);
      text-decoration: underline;
      text-underline-offset: var(--size-1);
    }
  }

  /* Responsive Display Rules */
  @media (min-width: 768px) {
    .menu-toggle-btn {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    /* Hide the global header layout row items on small mobile screens */
    .global-lane .nav-links {
      display: none !important;
    }

    /* Transform Context Lane into a clean horizontal swiping tray on mobile */
    .context-lane {
      justify-content: flex-start;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-inline: var(--size-3);
    }
    .context-lane::-webkit-scrollbar {
      display: none;
    }

    /* 1. TIGHTEN THE FLEX CONTAINER GAP */
    .context-lane .nav-links {
      /* Dropping this down from size-4 minimizes the blank space between items */
      gap: var(--size-1);
    }

    /* 2. SCALE DOWN THE SIDE PADDING ON MOBILE */
    .context-lane .nav-links a {
      /* Slightly less inner padding makes tap targets efficient without wasting space */
      padding-inline: var(--size-2);
    }

    /* Keep your main overview-link aligned cleanly with your page margin */
    .context-lane .nav-links a.overview-link {
      padding-inline-start: 0;
    }

    /* Hide the vertical pipe lines on mobile devices to prevent layout clutter */
    .context-lane .nav-links a::after {
      display: none !important;
    }
  }
</style>
