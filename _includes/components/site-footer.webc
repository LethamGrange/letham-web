<footer class="footer">
  <p>&copy; Letham Grange Curling Club</p>

  <nav webc:if="$data.footer.links">
    <a
      :href="link.url"
      webc:for="link of $data.footer.links"
      @text="link.label"
      webc:if="!link.hidden"
    ></a>
  </nav>
</footer>

<style>
  :where(.footer) {
    --footer-background-color: light-dark(#f1f1f1, #1a1a1a);
    --footer-text-color: light-dark(#424242, #bdbdbd);
    --footer-link-color: light-dark(#1b70df, #82b1ff);

    --footer-background-color: light-dark(#f1f1f1, #1a1a1a);
    --footer-text-color: light-dark(#424242, #bdbdbd);
    --footer-link-color: light-dark(#1b70df, #82b1ff);
    background-color: var(--footer-background-color);
    color: var(--footer-text-color);
    text-align: center;
    padding: 1rem;
    display: grid;
    align-items: center;
    grid-template-areas: "pile";

    a {
      color: var(--footer-link-color);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    p {
      text-wrap: pretty;
      grid-area: pile;
      justify-self: start;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      margin-top: 0.5rem;
      display: flex;
      align-self: center;
      justify-self: center;
      grid-area: pile;
      justify-self: center;
    }

    nav a {
      color: var(--footer-link-color);
      text-decoration: none;
      font-weight: 500;
    }

    nav a:hover {
      text-decoration: underline;
    }
  }
  @media (--md-n-below) {
    .footer {
      font-size: 0.75rem;
      padding: 0.75rem;
    }
  }
</style>
