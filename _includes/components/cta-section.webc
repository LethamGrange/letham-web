<div class="full-width cta-background-section" webc:root="override">
  <!-- 1. The native image tag Eleventy CAN see and optimize -->
  <img :src="imgSrc" alt="" class="cta-bg-image" />

  <!-- 2. The dark overlay tint layer -->
  <div class="cta-overlay"></div>

  <!-- 3. The structural text layout slot -->
  <div class="cta-content">
    <slot></slot>
  </div>
</div>

<style>
  .cta-background-section {
    grid-column: full-width;
    display: grid;
    grid-template-columns: inherit;
    position: relative;
    overflow: hidden;

    /* 1. Open Props layout spacing */
    padding-block: var(--size-6);
    margin-block: var(--size-2);

    /* 2. Swapped raw pixels for the responsive Open Props size token */
    max-height: calc(1.2 * var(--size-14));
  }

  /* Ensure text stays perfectly balanced inside your Open Props bounding box */
  .cta-content {
    grid-column: breakout;
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* Keeps everything locked to the physical center line */
    gap: var(--size-4);
    margin-block: var(--size-2);
    /* Optional safety: ensure the text never stretches taller than the size token container */
    min-height: calc(
      (1.2 * var(--size-14)) - (2 * var(--size-2)) - (var(--size-6) * 2)
    );
  }
  /* Ensure the image tag updates smoothly within the parent bounds */
  img.cta-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100% !important;
    object-fit: cover;

    /* Keep focus perfectly centered so cropping happens equally at top and bottom */
    object-position: center center;
    z-index: 1;
  }

  /* Semi-transparent dark overlay sheet */
  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 2;
  }

  .cta-content :is(h1, h2, h3, p) {
    max-inline-size: none;
    margin-inline: auto;
    width: 100%;
  }

  .cta-contentx h2 {
    background: var(--blue-6);
  }

  .cta-content p {
    max-inline-size: var(--size-content-3);
    color: var(--gray-1);
    font-size: var(--font-size-3);
  }
  /* A quick Open Props button style */
  .cta-button {
    display: inline-block;
    background: var(--blue-6);
    color: white;
    font-weight: var(--font-weight-6);
    padding: var(--size-2) var(--size-4);
    border-radius: var(--radius-2);
    text-decoration: none;
    box-shadow: var(--shadow-2);
    transition: transform 0.2s ease;
  }

  .cta-button:hover {
    transform: scale(1.05);
  }
</style>
