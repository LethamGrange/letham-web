<!-- 1. ADD DATA-THEME="DARK" HERE: Permanently isolates this container -->
<div
  class="full-width cta-background-section"
  data-theme="dark"
  webc:root="override"
>
  <!-- The native image tag Eleventy CAN see and optimize -->
  <img :src="imgSrc" alt="" class="cta-bg-image" />

  <!-- The dark overlay tint layer -->
  <div class="cta-overlay"></div>

  <!-- The structural text layout slot -->
  <div class="cta-content">
    <slot></slot>
  </div>
</div>

<style>
  /* 1. STRUCTURAL BOUNDING BOX CONTAINER PATTERNS */
  .cta-background-section {
    grid-column: full-width;
    display: grid;
    grid-template-columns: inherit;
    position: relative;
    overflow: hidden;

    padding-block: var(
      --size-8
    ); /* Upgraded for cleaner layout padding rhythm */
    margin-block: var(--size-4);
    max-height: calc(1.5 * var(--size-14));
  }

  .cta-content {
    grid-column: breakout;
    position: relative;
    z-index: 3;
    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--size-4);
  }

  img.cta-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100% !important;
    object-fit: cover;
    object-position: center center;
    z-index: 1;
  }

  /* 2. RE-TUNED INTENSITY ACCENT SHEET */
  .cta-overlay {
    position: absolute;
    inset: 0;
    /* Boosted opacity slightly to ensure AA compliance against bright elements in imagery */
    background: rgba(0, 0, 0, 0.35);
    z-index: 2;
  }

  /* 3. CLEAN FRAMEWORK INTEGRATION */
  /* Because the parent wrapper has data-theme="dark", these structural system tokens
     automatically evaluate to pure high-contrast values, bypassing the page cascade */
  .cta-content h2 {
    color: var(--gray-1); /* Stark high-contrast title */
    font-size: var(--font-size-6);
    text-wrap: balance;
  }

  .cta-content p {
    max-inline-size: var(--size-content-3);
    color: var(--gray-3); /* Smooth accessible subtext description spacing */
    font-size: var(--font-size-3);
    text-wrap: pretty;
  }

  /* 4. LEVERAGING YOUR LOCAL PEER DROPDOWN RULES INSTEAD OF CUSTOM BUTTON CLASSES */
  /* You no longer need custom `.cta-button` code blocks! Just call the native OPUI utility class
     combination inside your Markdown slots: class="ui-button ui-filled ui-primary" */
  .cta-content :where(.ui-button) {
    box-shadow: var(--shadow-3);
    transition: transform 0.2s ease;
  }

  .cta-content :where(.ui-button):hover {
    transform: scale(1.05);
  }
</style>
