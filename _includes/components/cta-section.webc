<div class="full-width cta-background-section" webc:root="override">
  <!-- 1. The native image tag Eleventy CAN see and optimize -->
  <img :src="imgSrc" alt="" class="cta-bg-image" />

  <!-- 2. The dark overlay tint layer -->
  <div class="cta-overlay"></div>

  <!-- 3. The structural text layout slot -->
  <div class="cta-content">
    <slot></slot>
  </div>
</div>

<style>
  /* Stack things horizontally using CSS Grid layering */
  .cta-background-section {
    grid-column: full-width;
    display: grid;
    grid-template-columns: inherit;
    position: relative; /* Anchor for absolute elements */
    padding-block: var(--size-9);
    margin-block: var(--size-8);
    overflow: hidden;
  }

  /* Force the image to cover the exact area of the parent grid block */
  img.cta-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100% !important;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  /* Semi-transparent dark overlay sheet */
  .cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 2;
  }

  /* Keep the text content floating safely on top */
  .cta-content {
    grid-column: content;
    position: relative;
    z-index: 3;
    text-align: center;
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--size-4);
  }

  .cta-content :is(h1, h2, h3, p) {
    max-inline-size: none;
    margin-inline: auto;
    width: 100%;
  }

  .cta-content p {
    max-inline-size: var(--size-content-3);
    color: var(--gray-2);
  }
  /* A quick Open Props button style */
  .cta-button {
    display: inline-block;
    background: var(--blue-6);
    color: white;
    font-weight: var(--font-weight-6);
    padding: var(--size-2) var(--size-4);
    border-radius: var(--radius-2);
    text-decoration: none;
    box-shadow: var(--shadow-2);
    transition: transform 0.2s ease;
  }

  .cta-button:hover {
    transform: scale(1.05);
  }
</style>
