<!-- _components/page-header.webc -->
<figure class="page-header" :position="pos" webc:root="override">
  <!-- The background image (whether 11ty leaves it naked or wraps it) -->
  <picture webc:if="image">
    <img
      class="page-header-image"
      :src="image"
      :alt="alt || 'Section header graphic'"
      width="1980"
      sizes="100svw"
    />
  </picture>

  <!-- The text overlay content block -->
  <div class="page-header-info">
    <div class="content">
      <h1 @text="title"></h1>
      <p webc:if="description" @text="description"></p>
    </div>
  </div>
</figure>

<style>
  .page-header {
    background-color: var(--color-7);
    background-image: var(--themed-gradient-30);
    grid-template-columns: auto 1fr;
    align-items: center;
    height: max(5rem, min(10vw, 8rem));
    display: grid;
    overflow: hidden;
    gap: var(--size-4);

    > picture,
    > img,
    .page-header-info {
      grid-column: 2/3;
      max-inline-size: var(--size-content-3, 75ch);
      justify-self: start;
      padding-inline-start: var(--size-7);
      display: flex;
    }

    .page-header-image {
      grid-column: 1 / 2;
      padding-inline-start: var(--size-2);
      margin-inline-start: var(--size-3);
    }

    /* 3. Style the background graphic layer */
    img {
      object-fit: contain;
      object-position: bottom;
      width: 100%;
      height: 100%;
      min-height: 0;
      max-inline-size: var(--size-10);
    }

    /* Position attributes target the image directly and cleanly */
    &[position="top"] img {
      object-position: top;
    }
    &[position="center"] img {
      object-position: center;
    }
    &[position="bottom"] img {
      object-position: bottom;
    }

    /* 4. Style the text information layer */
    .page-header-info {
      display: flex;
      padding-inline-start: var(--size-7);
      max-inline-size: var(--size-content-3, 75ch);
      justify-self: start;

      .content {
        justify-content: center;
        gap: var(--size-2, 8px);
        background: var(--color-7);
        max-width: 560px;
        flex-direction: column;
        flex: 1;
        width: 95%;
        display: flex;
        border-radius: var(--border-radius);

        > h1 {
          font-family: "Merriweather Sans", sans-serif;
          font-size: clamp(
            1.5rem,
            3.5vw,
            2.25rem
          ); /* Tweak sizes slightly for fluid header */

          line-height: var(--font-lineheight-1, 1.1);
          font-weight: 800;
          letter-spacing: -0.03em;
          color: var(--gray-2);
          text-shadow: 0 var(--size-1) var(--size-2)
            color-mix(in oklch, var(--color-1) 35%, transparent);
        }

        > p {
          font-size: clamp(0.95rem, 1.8vw, 1.1rem);
          max-inline-size: 100%;
          color: var(--gray-2);
          font-weight: 500;
          padding-inline-end: var(--size-6, 2rem);
        }
      }
    }
  }
</style>
