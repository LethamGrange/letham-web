<article :class="class" :style="flip ? '--order: 1' : '--order: -1'">
  <!-- Image Column -->
  <div class="card-image" webc:if="imgSrc">
    <img :src="imgSrc" :alt="imgAlt || ''" loading="lazy">
  </div>

  <!-- Text Content Column -->
  <div class="card-content">
    <slot></slot>
  </div>
</article>

<style>
  /* The parent container sets up the responsive two-column grid */
  article {
    display: grid;
    gap: var(--size-6);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: center;
    background: var(--surface-2);
    padding: var(--size-6);
    border-radius: var(--radius-3);
    border: 1px solid var(--surface-3);
    box-shadow: var(--shadow-2);
    margin-block: var(--size-6);
  }

  /* The image wrapper enforces neat layout sizing */
  .card-image {
    width: 100%;
    order: var(--order, -1); /* Controlled by the 'flip' property */
  }

  .card-image img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-widescreen); /* Keeps images looking consistent */
    object-fit: cover;
    border-radius: var(--radius-2);
  }

  /* Typography spacing inside the card text slot */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  .card-content h3 {
    font-size: var(--font-size-5);
    color: var(--text-1);
    margin: 0;
  }

  /* Responsive adjustment for small phone viewports */
  @media (max-width: 480px) {
    .card-image {
      order: -1 !important; /* Always put image on top on tiny screens */
    }
  }
</style>

