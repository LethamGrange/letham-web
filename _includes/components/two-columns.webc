<div class="two-columns-section" webc:root="override">
  <div class="column-left">
    <slot name="left"></slot>
  </div>
  <div class="column-right">
    <slot name="right"></slot>
  </div>
</div>

<style>
  .two-columns-section {
    grid-column: content; /* Keeps the container inside your centered lane */
    display: grid;
    gap: var(--size-7);
    margin-block: var(--size-7);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  /* Keep standard line spacing rules inside your column text blocks */
  .column-left,
  .column-right {
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }
</style>
