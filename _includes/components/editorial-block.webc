<!-- components/editorial-block.webc -->
<div class="editorial-wrapper">
  <div class="editorial-mesh" :data-align="align || 'right'">
    <div class="prose-pane prose">
      <slot></slot>
    </div>

    <figure class="image-pane">
      <!--
        WebC Attributes:
        1. Pass source, alt, and native dimensional metadata dynamically.
        2. Set the structural 35ch size definition as a constant rule.
      -->
      <slot name="image">
        <img
          :src="src"
          :alt="alt"
          :width="width"
          height="auto"
          sizes="(min-width: 50rem) 35ch, 90vw"
      /></slot>

      <figcaption webc:if="caption" @text="caption"></figcaption>
    </figure>
  </div>
</div>

<style webc:keep>
  .prose-pane {
    background-color: var(--pane-bg, transparent);
    color: contrast-color(var(--pane-bg));
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;

    > p + p {
      margin-block-start: 1em;
    }
  }

  @container not style(--pane-bg: initial) {
    .prose-pane {
      padding: 1.5em;
      border-radius: var(--radius-3);
    }
  }

  .editorial-wrapper {
    container-type: inline-size;
    width: 100%;
    margin-block: var(--size-6);
  }

  /* Mobile View: Uniform vertical stack */
  .editorial-mesh {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--size-5);
  }

  /* Container Query: Fires when there is enough inline room */
  @container (min-width: 38rem) {
    .editorial-mesh {
      grid-template-columns: 1.5fr 1fr;
      align-items: center; /* Clean, beautiful middle-alignment for text next to image */
      gap: var(--size-7);
    }

    .editorial-mesh[data-align="left"] {
      direction: rtl;
    }
    .editorial-mesh[data-align="left"] > * {
      direction: ltr;
    }
  }

  /* --- The Image Pane Layout Anchor --- */
  .image-pane {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--size-2, 0.5rem);

    img {
      width: 100%;
      max-inline-size: 30ch; /* Keeps the certificate crisp and un-stretched */
      height: auto;
      border-radius: var(--radius-2);
      box-shadow: var(--shadow-3);
    }

    figcaption {
      font-size: var(--font-size-0);
      color: var(--text-secondary, var(--text-2));
      line-height: var(--font-lineheight-2, 1.4);
      font-style: italic;
      margin: 0;
    }
  }
</style>
