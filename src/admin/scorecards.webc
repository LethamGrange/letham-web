---
title: Record Match Scores
pagetitle: Letham Grange Curling
headerImage: /images/logo-high.png
headerAlt: Letham Grange logo
---

<div class="breakout">
  <h1 class="ui-h2">Admin: Record Match Score</h1>
  <div id="form-error-banner"></div>
  <div class="sign-out-wrapper">
    <button hx-post="/api/logout" class="ui-button ui-tonal logout-btn">
      Sign Out
    </button>
  </div>

  <scorecard-manager> </scorecard-manager>

  <h2>Recent Results Log</h2>
  <div
    id="recent-results"
    hx-get="/api/get-scores"
    hx-trigger="load"
    hx-swap="outerHTML"
  >
    <div
      class="loading-placeholder"
      style="color: var(--text-3); padding: var(--size-3)"
    >
      Loading latest scorecards...
    </div>
  </div>
</div>
<style>
  .sign-out-wrapper {
    display: flex;
    justify-content: end;
  }
</style>
