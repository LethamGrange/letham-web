<slot></slot>
<script>
  class ScorecardManager extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      const errorBanner = document.getElementById('form-error-banner');

      const submitBtn = this.querySelector('button[type="submit"]');

      const inputA = form.querySelector('[name="team_a_name"]');
      const inputB = form.querySelector('[name="team_b_name"]');

      const labelA = form.querySelector('#label-team-a');
      const labelB = form.querySelector('#label-team-b');
      const totalAEl = document.getElementById('running-total-a');
      const totalBEl = document.getElementById('running-total-b');

      // Helper function to calculate math for all 12 ends dynamically
      function updateRunningTotals() {
        let totalA = 0;
        let totalB = 0;

        for (let end = 1; end <= 12; end++) {
          const valA = form.querySelector(`[name="e${end}_a"]`)?.value;
          const valB = form.querySelector(`[name="e${end}_b"]`)?.value;

          totalA += parseInt(valA) || 0;
          totalB += parseInt(valB) || 0;
        }

        // Push the fresh values straight into the UI text nodes
        totalAEl.textContent = totalA;
        totalBEl.textContent = totalB;
      }

      // DYNAMIC NAME SYNC FUNCTION
      const syncLabels = () => {
        // If a name is typed, show it. Otherwise, fall back to the defaults.
        labelA.textContent = inputA.value.trim()
          ? `${inputA.value.trim()}`
          : 'Team A';
        labelB.textContent = inputB.value.trim()
          ? `${inputB.value.trim()}`
          : 'Team B';
      };

      // Listen for real-time keystrokes on both inputs
      if (inputA && labelA) inputA.addEventListener('input', syncLabels);
      if (inputB && labelB) inputB.addEventListener('input', syncLabels);

      setTimeout(syncLabels, 10);

      // Create a Cancel button dynamically if you haven't placed one in HTML yet
      let cancelBtn = this.querySelector('#cancel-edit-btn');
      if (!cancelBtn) {
        cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.id = 'cancel-edit-btn';
        cancelBtn.textContent = 'Cancel Edit ✕';
        cancelBtn.style.cssText =
          'display: none; background: var(--surface-2); margin-left: var(--size-2);';
        submitBtn.parentNode.insertBefore(cancelBtn, submitBtn.nextSibling);
      }

      this.populateClubMembers();

      // 1. CATCH THE BUBBLED EVENT FROM ANY DEEP MATCH CARD CLICK
      document.body.addEventListener('edit-scorecard-request', async event => {
        const matchId = event.detail.matchId;

        try {
          // 2. FETCH PURE JSON FROM CLOUDFLARE
          const response = await fetch(
            `/admin/get-raw-scorecard-json?id=${matchId}`,
          );
          if (!response.ok)
            throw new Error('Could not pull scorecard database records.');

          const data = await response.json();

          // 1. CRITICAL: Explicitly lock the database row ID into your hidden field
          const hiddenIdInput = form.querySelector('[name="match_id"]');
          if (hiddenIdInput) {
            hiddenIdInput.value = matchId;
          }

          // 3. AUTOMATED DOM DATA MAPPER
          // Loop keys and search form for matching named elements
          Object.keys(data).forEach(key => {
            const input = form.querySelector(`[name="${key}"]`);
            if (input) {
              if (input.type === 'checkbox') {
                input.checked = !!data[key];
              } else {
                input.value = data[key] !== null ? data[key] : '';
              }
              // Manually trigger a dispatch event if your competition picker
              // component needs to see changes (like toggling 'Other')
              if (key === 'competition_select') {
                input.dispatchEvent(new Event('change'));
              }
            }
          });

          // 4. SWITCH FORMS METHODS IN PLACE FOR HTMX PUT CODES
          form.setAttribute('hx-put', '/admin/submit-scorecard');
          form.removeAttribute('hx-post');
          htmx.process(form); // Rebinds the active lifecycle handlers to PUT

          submitBtn.textContent = 'Save Modifications 💾';
          cancelBtn.style.display = 'inline-block';

          // Bring workspace focus smoothly into window view
          this.scrollIntoView({ behavior: 'smooth' });
        } catch (error) {
          const errorBanner = document.getElementById('form-error-banner');
          if (errorBanner) {
            errorBanner.innerHTML = html`<div style="color:var(--red-6)">
              ⚠️ ${error.message}
            </div>`;
          }
        }
        setTimeout(syncLabels, 10);

        // Add this right after you populate your form fields with JSON edit data:
        updateRunningTotals();
      });

      // 5. THE CLEAN RESET PATHway TO CREATE MODE
      cancelBtn.addEventListener('click', () => {
        form.reset();

        // Wipe the hidden identifier completely
        const hiddenId = form.querySelector('[name="match_id"]');
        if (hiddenId) hiddenId.value = '';

        // Revert from PUT back to standard POST
        form.setAttribute('hx-post', '/admin/submit-scorecard');
        form.removeAttribute('hx-put');
        htmx.process(form);

        submitBtn.textContent = 'Log New Scorecard';
        cancelBtn.style.display = 'none';

        // If your competition picker element hides custom text strings on reset, trigger it
        const compSelect = form.querySelector('[name="competition_select"]');
        if (compSelect) compSelect.dispatchEvent(new Event('change'));

        setTimeout(syncLabels, 10);
      });

      document.addEventListener('htmx:responseError', function (event) {
        const status = event.detail.xhr.status;

        if (status === 401 || status === 403) {
          // Prevent htmx from making a mess of the DOM
          event.preventDefault();

          // Grab the current path and redirect
          const currentPath = window.location.pathname;
          window.location.href = `/login?next=${encodeURIComponent(currentPath)}`;
        }
      });

      // Event 1: Before htmx swaps data, inspect the server status code
      document.body.addEventListener('htmx:beforeOnLoad', event => {
        const status = event.detail.xhr.status;

        // 1. Handle session expiration / unauthorised access
        if (status === 401 || status === 403) {
          // Stop htmx from processing anything else
          event.detail.shouldSwap = false;

          // Grab the current path and jump to login
          const currentPath = window.location.pathname;
          window.location.href = `/login?next=${encodeURIComponent(currentPath)}`;
          return;
        }

        if (status === 400 || status === 500) {
          // 1. Stop htmx from swapping the error message into the #recent-results list
          event.detail.shouldSwap = false;

          // 2. Inject the server's error message straight into our safe static banner
          errorBanner.innerHTML = html`
            <div
              style="background: var(--red-1); color: var(--red-9); border: 1px solid var(--red-3); padding: var(--size-3); margin-bottom: var(--size-3); border-radius: var(--radius-2); font-weight: bold;"
            >
              ⚠️ ${event.detail.xhr.responseText}
            </div>
          `;
        } else if (status === 200) {
          errorBanner.innerHTML = '';

          const isJustRefreshingList =
            event.detail.target.id === 'recent-results';

          if (!isJustRefreshingList) {
            submitBtn.textContent = 'Log New Scorecard';
            cancelBtn.style.display = 'none';

            const compSelect = form.querySelector(
              '[name="competition_select"]',
            );
            if (compSelect) compSelect.dispatchEvent(new Event('change'));

            setTimeout(() => {
              form.reset();
            }, 50);
            setTimeout(syncLabels, 10);
          }
        }
      });
    }

    // 4. Isolate the async network logic into a dedicated method
    async populateClubMembers() {
      const datalist = document.getElementById('club-members');
      if (!datalist) return;

      try {
        const response = await fetch('/admin/get-club-members');
        if (response.ok) {
          const members = await response.json();
          datalist.innerHTML = members
            .map(name => html`<option value="${name}"></option>`)
            .join('');
        }
      } catch (err) {
        console.error('Background autocomplete population failed:', err);
      }
    }
  }

  if ('customElements' in window) {
    customElements.define('scorecard-manager', ScorecardManager);
  }
</script>
<style>
  /* ==========================================================================
   SCORECARD ADMISSIONS & CONTEXT MENU GRID COMPONENTS
   ========================================================================== */

  /* Anchor assignment bridge */
  .popover-trigger {
    anchor-name: var(--anchor-id);
    background: none;
    border: none;
    font-size: var(--font-size-3);
    cursor: pointer;
    padding: var(--size-1);
    line-height: 1;
    color: var(--text-2);
  }

  .popover-trigger:hover {
    color: var(--text-1);
  }

  /* Base structural layout for top-layer anchor element containers */
  [popover].popover-menu {
    display: none;
    position-anchor: var(--anchor-id);
    margin: 0;
    inset: auto;
    top: anchor(bottom);
    right: anchor(right);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-3);
    padding: var(--size-1);
    grid-template-columns: 1fr;
    row-gap: var(--size-1);
    min-width: 160px;
  }

  /* Activate CSS Grid structures natively when popover wakes */
  [popover].popover-menu:popover-open {
    display: grid;
  }

  /* Standardized row-item layout controls inside context layer */
  .popover-menu .popover-item {
    background: none;
    border: none;
    text-align: left;
    padding: var(--size-2) var(--size-3);
    cursor: pointer;
    font-weight: bold;
    font-size: var(--font-size-1);
    border-radius: var(--radius-1);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--size-2);
    align-items: center;
  }

  .popover-menu .popover-item:focus-visible {
    outline: 2px solid var(--brand);
  }

  /* Context Variations */
  .popover-menu .edit-action {
    color: var(--text-1);
  }

  .popover-menu .edit-action:hover {
    background: var(--surface-3);
  }

  .popover-menu .delete-action {
    color: var(--red-6);
  }

  .popover-menu .delete-action:hover {
    background: var(--red-1);
  }

  /* Semantic line separator controls */
  .popover-menu .popover-divider {
    border: 0;
    border-top: 1px solid var(--border);
    width: 100%;
    margin: 0;
  }
</style>
