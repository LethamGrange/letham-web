<div id="form-error-message"></div>
<form
  novalidate
  class="scorecard"
  hx-post="/admin/submit-scorecard"
  hx-target="#recent-results"
  hx-swap="innerHTML"
>
  <h2 class="form-mode-title">Log New Match Scorecard</h2>

  <fieldset style="display: flex; gap: 40px">
    <legend>Details</legend>

    <!-- 1. Metadata -->
    <div
      style="
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        flex: 1;
      "
    >
      <input type="hidden" name="match[id]" value="" />
      <div>
        <label>Date:</label><br />
        <input type="date" name="match[date]" required />
      </div>
      <div>
        <label>Time / Draw:</label><br />
        <input type="time" step="300" name="match[time]" required />
      </div>
      <div>
        <label>Sheet:</label><br />
        <select name="match[sheet]" required>
          <option value="A">Sheet A</option>
          <option value="B">Sheet B</option>
          <option value="C">Sheet C</option>
          <option value="D">Sheet D</option>
          <option value="E">Sheet E</option>
          <option value="F">Sheet F</option>
        </select>
      </div>
      <competition-picker></competition-picker>
    </div>
  </fieldset>

  <!-- 2. Teams & Rosters -->
  <fieldset style="display: flex; gap: 40px">
    <legend>Teams</legend>

    <!-- Team A Column -->
    <div>
      <h3>Team A</h3>
      <input
        type="text"
        name="team[a][name]"
        placeholder="Team or Rink name"
        list="club-members"
        required
      />
      <h4>Names:</h4>
      <div
        class="form-input"
        webc:for="player of ['Skip', 'Third', 'Second','Lead']"
      >
        <input
          type="text"
          :name="`team[a][players][${player.toLowerCase()}]`"
          :placeholder="player"
          list="club-members"
        />
      </div>
    </div>

    <!-- Team B Column -->
    <div>
      <h3>Team B</h3>
      <input
        type="text"
        name="team[b][name]"
        placeholder="Team or Rink name"
        list="club-members"
        required
      />
      <h4>Names:</h4>
      <div
        class="form-input"
        webc:for="player of ['Skip', 'Third', 'Second','Lead']"
      >
        <input
          type="text"
          :name="`team[b][players][${player.toLowerCase()}]`"
          :placeholder="player"
          list="club-members"
        />
      </div>
    </div>
  </fieldset>

  <line-scores></line-scores>

  <br />

  <div class="form-actions-container">
    <!-- Left Side: Task-Specific Operations -->
    <div class="task-actions">
      <button type="submit" class="ui-button ui-filled ui-primary">
        Save Scorecard
      </button>
      <button
        type="button"
        class="cancel-edit-btn ui-button action-cancel ui-tonal"
        style="display: none"
      >
        Cancel Edits
      </button>
    </div>

    <!-- Right Side: Context Switcher -->
    <div class="context-actions">
      <button
        type="button"
        class="switch-to-create-btn action-create ui-button ui-filled"
        style="display: none"
      >
        Create New Scorecard
      </button>
    </div>
  </div>
</form>

<datalist id="club-members"></datalist>

<script src="/js/scorecard-manager.js" type="module" webc:keep></script>
<style>
  @layer components.extended {
    .ui-tonal.action-cancel {
      /* Light Mode: Super soft color tint
       Dark Mode: Deep, quiet charcoal/tint step (keeps luminance way down) */
      background-color: light-dark(var(--color-2), var(--color-2));

      /* Ensure the text contrast drops safely without being completely unreadable */
      color: light-dark(var(--color-12), var(--color-11));

      /* Smooth focus & hover states so it still feels responsive */
      &:hover {
        background-color: light-dark(var(--color-3), var(--color-3));
      }
    }
    .ui-filled.action-create {
      background-color: light-dark(var(--gray-11), var(--gray-4));
      color: light-dark(var(--gray-1), var(--gray-13));

      &:hover {
        background-color: light-dark(var(--gray-12), var(--gray-5));
      }
    }
  }

  #form-error-message {
    --red: hsl(0, 66%, 54%);
    --_critical: var(--red);

    color: var(--_critical);
    font-size: var(--size-4);
  }

  /* ==========================================================================
   SCORECARD ADMISSIONS & CONTEXT MENU GRID COMPONENTS
   ========================================================================== */
  :where(form) {
    --_border-color: light-dark(var(--color-7), var(--color-10));

    .form-actions-container {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      width: 100%;
      margin-top: 20px;
    }

    .task-actions {
      display: grid;
      grid-auto-flow: column;
      gap: 10px;
      justify-content: start;
    }

    .context-actions {
      justify-self: end;
    }

    > fieldset {
      border: 1px solid var(--border, var(--gray-8));
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      border-radius: var(--radius-2);

      legend {
        padding: 0 var(--size-1);
        font-weight: bold;
      }
    }

    input,
    textarea {
      background-color: var(--surface-default);
    }
    select {
      color: var(--text-primary);
      background: var(--surface-default);
      border: 1px solid var(--color-8);
    }

    input,
    textarea {
      border: 1px solid var(--_border-color);
      border-radius: 0.5rem;
      padding: 0.5em 0.75em;

      &:focus-visible {
        outline-color: var(--primary);
      }
    }
    > fieldset {
      border: 1px solid var(--border, var(--gray-8));
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      border-radius: var(--radius-2);

      legend {
        padding: 0 var(--size-1);
        font-weight: bold;
      }
    }

    #cancel-edit-btn {
      display: none;
    }
  }

  /* Anchor assignment bridge */
  .popover-trigger {
    anchor-name: var(--anchor-id);
    background: none;
    border: none;
    font-size: var(--font-size-3);
    cursor: pointer;
    padding: var(--size-1);
    line-height: 1;
    color: var(--text-2);
  }

  .popover-trigger:hover {
    color: var(--text-1);
  }

  /* Base structural layout for top-layer anchor element containers */
  [popover].popover-menu {
    display: none;
    position-anchor: var(--anchor-id);
    margin: 0;
    inset: auto;
    top: anchor(bottom);
    right: anchor(right);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-3);
    padding: var(--size-1);
    grid-template-columns: 1fr;
    row-gap: var(--size-1);
    min-width: 160px;
  }

  /* Activate CSS Grid structures natively when popover wakes */
  [popover].popover-menu:popover-open {
    display: grid;
  }

  /* Standardized row-item layout controls inside context layer */
  .popover-menu .popover-item {
    background: none;
    border: none;
    text-align: left;
    padding: var(--size-2) var(--size-3);
    cursor: pointer;
    font-weight: bold;
    font-size: var(--font-size-1);
    border-radius: var(--radius-1);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--size-2);
    align-items: center;
  }

  .popover-menu .popover-item:focus-visible {
    outline: 2px solid var(--brand);
  }

  /* Context Variations */
  .popover-menu .edit-action {
    color: var(--text-1);
  }

  .popover-menu .edit-action:hover {
    background: var(--surface-3);
  }

  .popover-menu .delete-action {
    color: var(--red-6);
  }

  .popover-menu .delete-action:hover {
    background: var(--red-1);
  }

  /* Semantic line separator controls */
  .popover-menu .popover-divider {
    border: 0;
    border-top: 1px solid var(--border);
    width: 100%;
    margin: 0;
  }

  h1,
  h2,
  h3 {
    max-inline-size: 100%;
  }
  h3 span {
    font-size: var(--size-3);
  }
  .error-message {
    color: var(--_critical);
    font-size: var(--size-3);
  }
</style>
