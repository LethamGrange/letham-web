<details class="accordion-section ui-accordion ui-card" open>
  <summary
    class="accordion-header"
    id="fixtures-summary-id"
    aria-controls="fixtures-content-id"
  >
    <div class="title-group">
      <span class="summary-title">3. Draw Schedule & Fixtures</span>
      <!-- Tracks total number of Scheduled Rounds at a glance -->
      <span class="count-pill fixture-draw-count">0</span>
    </div>

    <!-- This button stays clickable even when the outer accordion is closed -->
    <button class="ui-button ui-primary add-draw-btn" type="button">
      ＋ Add New Draw Date / Round
    </button>
  </summary>

  <div
    id="fixtures-content-id"
    class="ui-content accordion-content fixtures-zone"
    role="region"
    aria-labelledby="summary-id"
  >
    <div class="draw-dates-container"></div>
  </div>
</details>

<div
  id="global-team-picker"
  popover
  style="
    padding: 10px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    box-shadow: var(--shadow-2);
    border-radius: 6px;
  "
>
  <!-- JavaScript will inject the current team buttons here -->
</div>

<script type="module" src="/js/syllabus-fixtures.js" webc:keep></script>

<style>
  .accordion-sectionX {
    border: 1px solid var(--border, var(--gray-8));
    padding: var(--size-3);
    margin-bottom: var(--size-3);
    border-radius: var(--radius-2);
  } /* This replaces the fieldset look cleanly */
  .accordion-section.ui-card {
    background: var(--surface-default);
    border: 1px solid var(--border, var(--gray-8));
    border-radius: var(--radius-2, 8px);
    margin-bottom: var(--size-4, 16px);
    overflow: hidden; /* Prevents background color bleeding past corners */
  }

  /* Ensure content has padding only when the details section is open */
  .accordion-section[open] .accordion-content {
    padding: var(--size-3, 12px);
    display: flex;
    flex-direction: column;
    gap: var(--size-3, 12px);
  }
  .draw-game {
    border: 1px dashed var(--border);
    padding: 15px;
    margin-bottom: 15px;
    background: var(--surface-1);
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 5px;
  }
  .team-missing {
    color: var(--red);
  }

  .team-popover {
    display: flex;
    flex-direction: column;
    gap: 4px;

    .team-choice-btn {
      text-align: left;
      width: 100%;
    }
  }

  .add-draw-btn {
    border: 1px solid var(--color-8);
    margin-left: auto;
  }

  .add-game-btn {
    color: var(--primary-text);
  }
  .remove-draw-btn,
  .remove-game-btn {
    background: none;
    border: none;
    color: var(--red-6);
    cursor: pointer;
  }

  .draw-round-block {
    border: 1px dashed var(--border);
    padding-block: var(--size-3);
    background: var(--surface-1);

    .draw-round {
      display: flex;
      gap: 15px;
      margin-bottom: 10px;
    }
  }
  .team-picker-container {
    display: inline-block;
  }

  .team-picker-btn {
    overflow: hidden;
    text-overflow: ellipsis; /* Cuts off text with "..." if it gets too cramped */
  }

  .games-list-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, max-content));
    gap: var(--size-2);
    margin-block-start: var(--size-4);
  }
</style>
