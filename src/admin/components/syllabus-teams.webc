<fieldset class="teams-zone">
  <legend>2. Define Team / Rink Names</legend>

  <div class="teams-input-container">
    <!-- JavaScript appends Team 1, Team 2, etc. here on click -->
  </div>

  <button
    class="ui-button ui-primary add-team-btn"
    type="button"
    style="border: 1px solid var(--color-8)"
  >
    ＋ Add Team / Rink Row
  </button>
</fieldset>

<script type="module" src="/js/syllabus-teams.js" webc:keep></script>

<style>
  .teams-input-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-bottom: 15px;
  }
</style>
