<form
  hx-post="/admin/submit-syllabus"
  hx-target="#diary-preview"
  hx-swap="innerHTML"
>
  <!-- ZONE 1: FIXED PARAMETERS -->
  <fieldset>
    <legend>1. Competition Details</legend>
    <label>Competition Name:</label>

    <input type="hidden" name="competition[id]" value="" />
    <input type="text" name="competition[name]" required style="width: 250px" />

    <label style="margin-left: 15px">Format:</label>
    <select
      class="ui-select"
      id="competition-kind"
      name="competition[kind]"
      required
    >
      <option value="league">League</option>
      <option value="bonspiel">Bonspiel</option>
      <option value="friendly">Friendly</option>
    </select>

    <!-- Add inside Fieldset 1 (Competition Details) right at the bottom -->
    <div style="margin-top: var(--size-2)">
      <label>Competition Reserves (Comma separated list):</label><br />
      <input
        type="text"
        name="competition[reserves]"
        placeholder="e.g. John Hall, Jackie Hall"
        style="width: 100%"
      />
    </div>
  </fieldset>

  <!-- ZONE 2: DYNAMIC TEAMS DECLARATION (Now using the Add Button) -->
  <fieldset>
    <legend>2. Define Team / Rink Names</legend>

    <div id="teams-input-container">
      <!-- JavaScript appends Team 1, Team 2, etc. here on click -->
    </div>

    <button
      class="ui-button ui-primary"
      type="button"
      id="add-team-btn"
      style="border: 1px solid var(--color-8)"
    >
      ＋ Add Team / Rink Row
    </button>
  </fieldset>

  <!-- ZONE 3: DYNAMIC FIXTURES GRID -->
  <fieldset id="fixtures-zone" style="display: none">
    <legend>3. Draw Schedule & Fixtures</legend>
    <div id="draw-dates-container"></div>

    <button
      class="ui-button ui-primary"
      type="button"
      id="add-draw-btn"
      style="border: 1px solid var(--color-8)"
    >
      ＋ Add Another Draw Date / Round
    </button>
  </fieldset>

  <div
    id="global-team-picker"
    popover
    style="
      padding: 10px;
      border: 1px solid var(--border);
      background: var(--surface-1);
      box-shadow: var(--shadow-2);
      border-radius: 6px;
    "
  >
    <!-- JavaScript will inject the current team buttons here -->
  </div>

  <br />
  <button class="ui-button ui-filled ui-primary" type="submit">
    Save Complete Competition & Schedule 💾
  </button>
  <button
    class="ui-button ui-tonal"
    type="button"
    id="cancel-syllabus-edit"
    style="display: none"
  >
    Cancel Edit ✕
  </button>
</form>

<script>
  class SyllabusBuilder extends HTMLElement {
    teamsContainer;
    fixturesZone;
    drawsContainer;

    submitBtn;
    cancelBtn;

    // State counts tracked across mutations
    currentTeamCount = 0;
    currentDrawCount = 0;

    connectedCallback() {
      const form = this.querySelector("form");
      this.teamsContainer = this.querySelector("#teams-input-container");
      this.drawsContainer = this.querySelector("#draw-dates-container");
      this.fixturesZone = this.querySelector("#fixtures-zone");
      this.submitBtn = this.querySelector('button[type="submit"]');
      this.cancelBtn = this.querySelector("#cancel-syllabus-edit");

      const addTeamBtn = this.querySelector("#add-team-btn");
      const addDrawBtn = this.querySelector("#add-draw-btn");

      addTeamBtn.addEventListener("click", () => this.addTeam());
      addDrawBtn.addEventListener("click", () => this.addDrawBtn());

      document.body.addEventListener("edit-syllabus-request", async (event) =>
        this.onEditSyllabus(event, form),
      );

      // Kick off the URL inspection quietly on page mount
      this.loadSyllabusDataForEditing(form);

      this.cancelBtn.addEventListener("click", () => {
        // Simply redirect the browser back to the base admin page URL without parameters
        window.location.href = window.location.pathname;
      });
    } // connectedCallback

    reindexFormElements() {
      // 1. Re-index Team Cards
      const teamCards =
        this.teamsContainer.querySelectorAll(".team-entry-card");

      teamCards.forEach((card, index) => {
        const newIdx = index + 1;
        card.querySelector("label").innerHTML = `Team ${newIdx} Rink Name:`;
        card.querySelector('input[type="text"]').name = `team[${newIdx}].name`;

        const rosterInput = card.querySelector(`[name$=".players"]`);
        if (rosterInput) rosterInput.name = `team[${newIdx}].players`;

        const poolInput = card.querySelector(`[name$=".pool"]`);
        if (poolInput) poolInput.name = `team[${newIdx}].pool`;
      });

      // Update teamCount tracking state
      this.currentTeamCount = teamCards.length;

      // 2. Re-index Draw Blocks
      const drawBlocks =
        this.drawsContainer.querySelectorAll(".draw-round-block");

      drawBlocks.forEach((block, dIdx) => {
        const newDIdx = dIdx + 1;

        const gameRows = block.querySelectorAll(".game-row");
        gameRows.forEach((row, gIdx) => {
          row.querySelector('select[name*=".sheet"]').name =
            `draw[${newDIdx}].game[${gIdx}].sheet`;
          row.querySelector('select[name*=".team_a"]').name =
            `draw[${newDIdx}].game[${gIdx}].team_a`;
          row.querySelector('select[name*=".team_b"]').name =
            `draw[${newDIdx}].game[${gIdx}].<D-s>team_b`;
        });
      });

      // Update drawCount tracking state and sync dropdown text
      this.currentDrawCount = drawBlocks.length;
      this.updateAllFixtureDropdowns();
    }

    async loadSyllabusDataForEditing(form) {
      const urlParams = new URLSearchParams(window.location.search);
      const compId = urlParams.get("id");

      if (!compId) return; // Exit quietly if we are just creating a new syllabus

      try {
        const response = await fetch(
          `/admin/get-raw-syllabus-json?id=${compId}`,
        );
        if (!response.ok)
          throw new Error("Could not download competition schema profile.");
        const data = await response.json();

        // 1. Map Overarching Structural Form Fields
        form.querySelector('[name="competition_id"]').value =
          data.competition_id;
        form.querySelector('[name="competition_name"]').value =
          data.competition_name;
        form.querySelector('[name="competition_kind"]').value =
          data.competition_kind;
        form.querySelector('[name="competition_reserves"]').value =
          data.competition_reserves;

        // 2. Programmatically generate and populate Team Cards
        this.teamsContainer.innerHTML = "";
        this.currentTeamCount = 0;

        data.teams.forEach((t) => {
          this.currentTeamCount++;
          const div = document.createElement("div");
          div.className = "team-entry-card";
          div.style.cssText =
            "border: 1px solid var(--border); padding: var(--size-2); border-radius: var(--radius-1); background: var(--surface-2);";
          div.innerHTML = html`
            <div
              style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;"
            >
              <label style="font-weight: bold;"
                >Team ${this.currentTeamCount} Rink Name:</label
              >
              <button
                type="button"
                class="remove-row-btn"
                style="background:none; border:none; color:var(--red-6); cursor:pointer;"
              >
                ✕ Remove
              </button>
            </div>
            <div style="margin-bottom: 8px;">
              <label style="font-weight: bold;"
                >Team ${this.currentTeamCount} Rink Name:</label
              >
              <input
                type="text"
                name="team_name_${this.currentTeamCount}"
                value="${t.team_name}"
                style="width:100%;"
                required
              />
            </div>
            <div>
              <label
                style="font-size: var(--font-size-0); color: var(--text-2);"
                >Team Roster:</label
              >
              <input
                type="text"
                name="team_${this.currentTeamCount}_roster"
                value="${t.roster_string}"
                list="club-members"
                style="width:100%;"
              />
            </div>
            <div style="margin-top: 4px;">
              <label
                style="font-size: var(--font-size-0); color: var(--text-2);"
                >Sub / Pool Players:</label
              >
              <input
                type="text"
                name="team_${this.currentTeamCount}_pool"
                value="${t.pool_string}"
                list="club-members"
                style="width:100%;"
              />
            </div>
          `;
          div.querySelector(".remove-row-btn").addEventListener("click", () => {
            div.remove();
            this.reindexFormElements(); // Automatically updates names dynamically!
          });
          div
            .querySelector('input[type="text"]')
            .addEventListener("input", this.updateAllFixtureDropdowns);
          this.teamsContainer.appendChild(div);
        });

        // 3. Programmatically generate and populate Draw Fixture Rows
        this.drawsContainer.innerHTML = "";
        this.currentDrawCount = 0;
        this.fixturesZone.style.display = "block";

        data.draws.forEach((draw) => {
          this.currentDrawCount++;
          const drawBlock = document.createElement("div");
          drawBlock.className = "draw-round-block";
          drawBlock.style.cssText =
            "border: 1px dashed var(--border); padding: 15px; margin-bottom: 15px; background: var(--surface-1);";

          let drawsHtml = html`
            <div
              style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid var(--border); padding-bottom: 5px;"
            >
              <div style="display: flex; gap: 15px;">
                <div>
                  <label>Draw Date:</label><br /><input
                    type="date"
                    name="draw_date_${this.currentDrawCount}"
                    value="${draw?.date || ""}"
                    required
                  />
                </div>
                <div>
                  <label>Draw Time:</label><br /><input
                    type="time"
                    name="draw_time_${this.currentDrawCount}"
                    value="${draw?.time || ""}"
                    required
                  />
                </div>
              </div>

              <!-- THE FORM WORKSPACE DELETE BUTTON -->
              <button
                type="button"
                class="remove-draw-btn"
                style="background: none; border: 1px solid var(--red-3); color: var(--red-6); padding: var(--size-1) var(--size-2); border-radius: var(--radius-1); cursor: pointer; font-size: var(--font-size-0); font-weight: bold;"
              >
                ✕ Delete Draw Round
              </button>
            </div>
            <h4>Sheet Matchups</h4>
          `;
          const teamOptions = this.getActiveTeamOptions(this.currentTeamCount);
          const sheets = ["A", "B", "C", "D", "E", "F"];

          draw.games.forEach((game, gIndex) => {
            drawsHtml += html`
              <div
                style="display: flex; gap: 10px; align-items: center; margin-bottom: 5px;"
              >
                <select
                  name="draw_${this.currentDrawCount}_game_${gIndex}_sheet"
                >
                  ${sheets.map((s) => `<option value="${s}" ${s === game.sheet ? "selected" : ""}>Sheet ${s}</option>`).join("")}
                </select>
                <select
                  name="draw_${this.currentDrawCount}_game_${gIndex}_team_a"
                  class="team-select-node"
                  required
                >
                  ${teamOptions}
                </select>
                <span>vs</span>
                <select
                  name="draw_${this.currentDrawCount}_game_${gIndex}_team_b"
                  class="team-select-node"
                  required
                >
                  ${teamOptions}
                </select>
              </div>
            `;
          });

          drawBlock.innerHTML = drawsHtml;

          drawBlock
            .querySelector(".remove-draw-btn")
            .addEventListener("click", () => {
              drawBlock.remove();
              this.reindexFormElements(); // Automatically re-sequences draw_date_1, draw_date_2 etc.!
            });
          this.drawsContainer.appendChild(drawBlock);
          // Force the correct dropdown indices to bind once the elements are rendered
          draw.games.forEach((game, gIndex) => {
            drawBlock.querySelector(
              `[name="draw_${this.currentDrawCount}_game_${gIndex}_team_a"]`,
            ).value = game.team_a;
            drawBlock.querySelector(
              `[name="draw_${this.currentDrawCount}_game_${gIndex}_team_b"]`,
            ).value = game.team_b;
          });
        });

        // 4. Safely swap form attributes over to true PUT methods
        form.setAttribute(
          "hx-put",
          "/functions/admin/submit-complete-syllabus",
        );
        form.removeAttribute("hx-post");
        // htmx.process(form); // Explicitly tell htmx to re-index the method update

        this.submitBtn.textContent = "Save Schedule Revisions 💾";
        this.cancelBtn.style.display = "inline-block";
      } catch (err) {
        console.error("Auto-load edit mapping failed:", err);
      }
    }

    getActiveTeamOptions(count) {
      let options = html`<option value="">-- Select Team --</option>`;
      for (let i = 1; i <= this.currentTeamCount; i++) {
        const input = this.teamsContainer.querySelector(
          `[name="team[${i}].name"]`,
        );
        const nameValue =
          input && input.value.trim() ? input.value.trim() : `Team ${i}`;
        options += html`<option value="${i}">${nameValue}</option>`;
      }
      return options;
    }

    updateAllFixtureDropdowns() {
      const hiddenInputs =
        this.drawsContainer.querySelectorAll(".team-id-input");

      // Create an ordered list of all active backend IDs currently on the screen
      const activeTeamInputs = this.teamsContainer.querySelectorAll(
        'input[name^="team["][name$="].name"]',
      );
      const activeIds = Array.from(activeTeamInputs)
        .map((input) => {
          const match = input.name.match(/team\[(\d+)\]/);
          return match ? match[1] : null;
        })
        .filter(Boolean);

      hiddenInputs.forEach((input) => {
        const selectedTeamId = input.value;
        if (!selectedTeamId) return;

        const teamInput = this.teamsContainer.querySelector(
          `[name="team[${selectedTeamId}].name"]`,
        );
        const btn = input
          .closest(".team-picker-container")
          .querySelector(".team-picker-btn");

        if (!teamInput) {
          input.value = "";
          btn.textContent = "✕ Team Deleted";
          btn.style.color = "var(--red-6)";
        } else {
          btn.style.color = "";

          // Calculate what position this team ID currently holds in the active UI list (1-indexed)
          const userFacingIndex = activeIds.indexOf(selectedTeamId) + 1;
          const teamName = teamInput.value.trim();

          // If they haven't typed a name, say "Team 2". If they have, show "Team 2: Smith"
          const displayStyle = teamName
            ? `Team ${userFacingIndex}: ${teamName}`
            : `Team ${userFacingIndex}`;

          btn.textContent = displayStyle;
        }
      });
    }

    updateVisualTeamLabels() {
      // Grab all active labels currently inside the teams container
      const labels = this.teamsContainer.querySelectorAll(".team-number-label");

      labels.forEach((label, index) => {
        // index is 0-based, so add 1 for user presentation (Team 1, Team 2, etc.)
        label.textContent = `Team ${index + 1} Name:`;
      });
    }

    addTeam() {
      this.currentTeamCount++;

      const div = document.createElement("div");
      div.className = "team-entry-card";
      div.style.cssText = html`border: 1px solid var(--border); padding:
      var(--size-2); border-radius: var(--radius-1); background:
      var(--surface-2);`;

      // Base Rink Name Input
      let teamHtml = html`<div
          style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;"
        >
          <label style="font-weight: bold;" class="team-number-label"
            >Team ${this.currentTeamCount} Name:</label
          >
          <button
            type="button"
            class="remove-row-btn"
            style="background:none; border:none; color:var(--red-6); cursor:pointer;"
          >
            ✕ Remove
          </button>
        </div>

        <div
          style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;"
        >
          <input
            type="text"
            name="team[${this.currentTeamCount}].name"
            placeholder="e.g., Team Smith"
            style="width:100%;"
            required
          />
        </div>
        <div
          style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;"
        ></div> `;

      teamHtml += html`
        <div>
          <label style="font-size: var(--font-size-0); color: var(--text-2);"
            >Team players (Add (s) after the skip's name)</label
          >
          <input type="text" name="team[${this.currentTeamCount}].players" />
        </div>
      `;

      // Pool Players text field
      teamHtml += html`
        <div>
          <label style="font-size: var(--font-size-0); color: var(--text-2);"
            >Pool / Sub Players (Comma separated):</label
          >
          <input
            type="text"
            name="team[${this.currentTeamCount}].pool"
            placeholder="e.g. Brian McArtney, Jim Menzies"
            style="width:100%;"
          />
        </div>
      `;

      div.innerHTML = teamHtml;
      div.querySelector(".remove-row-btn").addEventListener("click", () => {
        div.remove();
        // 1. Fix the team numbers on the card headers
        this.updateVisualTeamLabels();

        // 2. Fix the names appearing on the fixture game buttons
        this.updateAllFixtureDropdowns();
      });

      // Keep your live dropdown text sync listening to the Rink Name box
      div
        .querySelector('input[type="text"]')
        .addEventListener("input", () => this.updateAllFixtureDropdowns());
      this.teamsContainer.appendChild(div);

      this.updateVisualTeamLabels(); // Update visual counts instantly

      // if (this.currentTeamCount >= 2) {
      this.fixturesZone.style.display = "block";
      //}
    }

    async onEditSyllabus(event, form) {
      const compId = event.detail.compId;

      try {
        const response = await fetch(
          `/admin/get-raw-syllabus-json?id=${compId}`,
        );
        if (!response.ok)
          throw new Error("Could not download competition schema profile.");
        const data = await response.json();

        // 1. Assign Basic Metadata Inputs
        form.querySelector('[name="competition_id"]').value =
          data.competition_id;
        form.querySelector('[name="competition_name"]').value =
          data.competition_name;
        form.querySelector('[name="competition_kind"]').value =
          data.competition_kind;
        form.querySelector('[name="competition_reserves"]').value =
          data.competition_reserves;

        // 2. Programmatically generate the exact number of Team Cards
        this.teamsContainer.innerHTML = "";
        this.currentTeamCount = 0;

        data.teams.forEach((t) => {
          this.currentTeamCount++;
          const div = document.createElement("div");
          div.className = "team-entry-card";
          div.style.cssText =
            "border: 1px solid var(--border); padding: var(--size-2); border-radius: var(--radius-1); background: var(--surface-2);";
          div.innerHTML = html`
            <div style="margin-bottom: 8px;">
              <label style="font-weight: bold;"
                >Team ${this.currentTeamCount} Rink Name:</label
              >
              <input
                type="text"
                name="team_name_${this.currentTeamCount}"
                value="${t.team_name}"
                style="width:100%;"
                required
              />
            </div>
            <div>
              <label
                style="font-size: var(--font-size-0); color: var(--text-2);"
                >Team Roster (Comma separated, append (s) for skip):</label
              >
              <input
                type="text"
                name="team_${this.currentTeamCount}_roster"
                value="${t.roster_string}"
                list="club-members"
                style="width:100%;"
              />
            </div>
            <div style="margin-top: 4px;">
              <label
                style="font-size: var(--font-size-0); color: var(--text-2);"
                >Sub / Pool Players (Comma separated):</label
              >
              <input
                type="text"
                name="team_${this.rrentTeamCount}_pool"
                value="${t.pool_string}"
                list="club-members"
                style="width:100%;"
              />
            </div>
          `;
          div
            .querySelector('input[type="text"]')
            .addEventListener("input", this.updateAllFixtureDropdowns);
          this.teamsContainer.appendChild(div);
        });

        // 3. Programmatically generate the dynamic Fixtures blocks grid
        this.drawsContainer.innerHTML = "";
        this.currentDrawCount = 0;
        this.fixturesZone.style.display = "block";

        data.draws.forEach((draw) => {
          this.currentDrawCount++;
          const drawBlock = document.createElement("div");
          drawBlock.className = "draw-round-block";
          drawBlock.style.cssText =
            "border: 1px dashed var(--border); padding: 15px; margin-bottom: 15px; background: var(--surface-1);";

          let drawsHtml = html`
            <div style="display: flex; gap: 15px; margin-bottom: 10px;">
              <div>
                <label>Draw Date:</label><br /><input
                  type="date"
                  name="draw_date_${this.currentDrawCount}"
                  value="${draw.date}"
                  required
                />
              </div>
              <div>
                <label>Draw Time:</label><br /><input
                  type="time"
                  name="draw_time_${this.currentDrawCount}"
                  value="${draw.time}"
                  required
                />
              </div>
            </div>
            <h4>Sheet Matchups</h4>
          `;

          const teamOptions = this.getActiveTeamOptions(this.currentTeamCount);
          const sheets = ["A", "B", "C", "D", "E", "F"];

          draw.games.forEach((game, gIndex) => {
            drawsHtml += html`
              <div
                style="display: flex; gap: 10px; align-items: center; margin-bottom: 5px;"
              >
                <select
                  name="draw_${this.currentDrawCount}_game_${gIndex}_sheet"
                >
                  ${sheets.map((s) => `<option value="${s}" ${s === game.sheet ? "selected" : ""}>Sheet ${s}</option>`).join("")}
                </select>
                <select
                  name="draw_${this.currentDrawCount}_game_${gIndex}_team_a"
                  class="team-select-node"
                  required
                >
                  ${teamOptions}
                </select>
                <span>vs</span>
                <select
                  name="draw_$this.urrentDrawCount}_game_${gIndex}_team_b"
                  class="team-select-node"
                  required
                >
                  ${teamOptions}
                </select>
              </div>
            `;
          });

          drawBlock.innerHTML = drawsHtml;
          this.drawsContainer.appendChild(drawBlock);

          // Reapply the specific dropdown index values once the HTML payload node exists!
          draw.games.forEach((game, gIndex) => {
            drawBlock.querySelector(
              `[name="draw_${this.currentDrawCount}_game_${gIndex}_team_a"]`,
            ).value = game.team_a;
            drawBlock.querySelector(
              `[name="draw_${this.currentDrawCount}_game_${gIndex}_team_b"]`,
            ).value = game.team_b;
          });
        });

        // 4. TRANSITION THE FORM HOOK FOR ACTION METHODS VIA HTMX
        form.setAttribute(
          "hx-put",
          "/functions/admin/submit-complete-syllabus",
        );
        form.removeAttribute("hx-post");
        htmx.process(form);

        submitBtn.textContent = "Save Schedule Revisions 💾";
        this.cancelBtn.style.display = "inline-block";
        this.scrollIntoView({ behavior: "smooth" });
      } catch (err) {
        console.error("Syllabus mapper extraction exception:", err);
      }
    }

    openTeamPicker(clickedBtn) {
      const container = clickedBtn.closest(".team-picker-container");
      const hiddenInput = container.querySelector(".team-id-input");
      const popover = document.getElementById("global-team-picker");

      // Query all team inputs alive in the DOM
      const activeTeamInputs = this.teamsContainer.querySelectorAll(
        'input[name^="team["][name$="].name"]',
      );

      let popoverHtml = html`<div
        style="display: flex; flex-direction: column; gap: 4px;"
      ></div>`;

      // A clean, gapless counter for visual display purposes
      let displayIndex = 1;

      activeTeamInputs.forEach((teamInput) => {
        const match = teamInput.name.match(/team\[(\d+)\]/);
        if (!match) return;

        const backendId = match[1]; // e.g. "5"
        const teamName = teamInput.value.trim()
          ? teamInput.value.trim()
          : `Unnamed Team`;

        popoverHtml += html`
          <button
            type="button"
            class="ui-button ui-ghost team-choice-btn"
            data-id="${backendId}"
            style="text-align: left; width: 100%;"
          >
            <!-- User sees continuous numbers (1, 2, 3), backend uses the persistent ID -->
            <strong>Team ${displayIndex}</strong>: ${teamName}
          </button>
        `;

        displayIndex++; // Increment sequentially
      });

      popoverHtml += html`</div>`;
      popover.innerHTML = popoverHtml;

      // Position and show popover logic remains the same...
      const rect = clickedBtn.getBoundingClientRect();
      popover.style.position = "absolute";
      popover.style.top = `${rect.bottom + window.scrollY + 4}px`;
      popover.style.left = `${rect.left + window.scrollX}px`;

      popover.querySelectorAll(".team-choice-btn").forEach((choiceBtn) => {
        choiceBtn.addEventListener("click", () => {
          hiddenInput.value = choiceBtn.dataset.id;
          clickedBtn.textContent = choiceBtn.textContent.trim();

          clickedBtn.style.color = "inherit";
          popover.hidePopover();
        });
      });

      popover.showPopover();
    }

    addGame(event) {
      // Prevent the button from trying to submit the form
      event.preventDefault();

      // 1. Find the parent fixture block that owns this clicked button
      const drawBlock = event.target.closest(".draw-round-block");
      if (!drawBlock) return; // Safety check

      // 1. Read the continuous game counter from the dataset, default to 0
      let gameCount = parseInt(drawBlock.dataset.gameCount || "0", 10);
      gameCount++;

      // 2. Save the incremented counter back to the block so it never decreases
      drawBlock.dataset.gameCount = gameCount;

      const g = gameCount; // This index is now unique and safe from gaps!
      const drawIndex = drawBlock.dataset.drawIndex;

      // 4. Create the new game row element
      const gameBlock = document.createElement("div");
      gameBlock.className = "draw-game";
      gameBlock.style.cssText = `border: 1px dashed var(--border); padding: 15px; margin-bottom: 15px; background: var(--surface-1);`;

      const teamOptions = this.getActiveTeamOptions();

      gameBlock.innerHTML = html`
        <div
          style="display: flex; gap: 10px; align-items: center; margin-bottom: 5px;"
        >
          <!-- Team A Picker Container -->
          <div class="team-picker-container" style="display: inline-block;">
            <input
              type="hidden"
              name="draw[${drawIndex}].game[${g}].team_a"
              value=""
              class="team-id-input"
              required
            />
            <button type="button" class="ui-button ui-outline team-picker-btn">
              -- Select Team --
            </button>
          </div>

          <span>vs</span>

          <!-- Team B Picker Container -->
          <div class="team-picker-container" style="display: inline-block;">
            <input
              type="hidden"
              name="draw[${drawIndex}].game[${g}].team_b"
              value=""
              class="team-id-input"
              required
            />
            <button type="button" class="ui-button ui-outline team-picker-btn">
              -- Select Team --
            </button>
          </div>

          <button
            type="button"
            class="remove-game-btn"
            style="background:none; border:none; color:var(--red-6); cursor:pointer;"
          >
            ✕ Remove
          </button>
        </div>
      `; // Hook up a single click listener for the row to handle picker triggers
      gameBlock.querySelectorAll(".team-picker-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => this.openTeamPicker(e.target));
      });

      // 5. Append the game block into this draw block
      // (You might want to append it just before the "Add Game" button container)
      drawBlock.appendChild(gameBlock);

      gameBlock
        .querySelector(".remove-game-btn")
        .addEventListener("click", () => {
          gameBlock.remove();
        });
    }

    addDrawBtn() {
      this.currentDrawCount++;

      const drawBlock = document.createElement("div");
      drawBlock.className = "draw-round-block"; // Store the draw count natively on the DOM element
      drawBlock.dataset.drawIndex = this.currentDrawCount;
      drawBlock.style.cssText = html`border: 1px dashed var(--border); padding:
      15px; margin-bottom: 15px; background: var(--surface-1);`;

      let drawHtml = html`
        <div style="display: flex; gap: 15px; margin-bottom: 10px;">
          <div>
            <label>Draw Date:</label><br /><input
              type="date"
              name="draw[${this.currentDrawCount}].date"
              required
            />
          </div>
          <div>
            <label>Draw Time:</label><br /><input
              type="time"
              step="300"
              name="draw[${this.currentDrawCount}].time"
              required
            />
          </div>
          <button
            type="button"
            class="remove-draw-btn"
            style="background:none; border:none; color:var(--red-6); cursor:pointer;"
          >
            ✕ Remove
          </button>
        </div>
        <div>
          <button class="ui-button ui-filled add-game-btn">Add game</button>
        </div>
      `;

      drawBlock.innerHTML = drawHtml;
      this.drawsContainer.appendChild(drawBlock);

      drawBlock
        .querySelector(".remove-draw-btn")
        .addEventListener("click", () => {
          drawBlock.remove();
        });

      // Listen directly on the button instead of the entire block to avoid accidental click triggers
      const addGameBtn = drawBlock.querySelector(".add-game-btn");
      addGameBtn.addEventListener("click", (event) => this.addGame(event));
    }
  } // end class SyllabusBuilder

  customElements.define("syllabus-builder", SyllabusBuilder);
</script>

<style>
  :where(form) {
    --_border-color: light-dark(var(--color-7), var(--color-10));

    input,
    button,
    textarea {
      background-color: var(--surface-default);
    }

    input,
    textarea {
      border: 1px solid var(--_border-color);
      border-radius: 0.5rem;
      padding: 0.5em 0.75em;

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    select {
      border: 1px solid var(--_border-color);
      background-color: var(--surface-default);

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    > fieldset {
      border: 1px solid var(--border, var(--gray-8));
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      border-radius: var(--radius-2);

      legend {
        padding: 0 var(--size-1);
        font-weight: bold;
      }
    }

    #teams-input-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 10px;
      margin-bottom: 15px;
    }
  }
</style>
