<form
  hx-post="/admin/submit-syllabus"
  hx-target="#diary-preview"
  hx-swap="innerHTML"
>
  <competition-meta></competition-meta>
  <syllabus-teams></syllabus-teams>
  <syllabus-fixtures></syllabus-fixtures>

  <br />
  <button class="ui-button ui-filled ui-primary" type="submit">
    Save Complete Competition & Schedule 💾
  </button>
  <button
    class="ui-button ui-tonal"
    type="button"
    id="cancel-syllabus-edit"
    style="display: none"
  >
    Cancel Edit ✕
  </button>
</form>

<script type="module" src="/js/syllabus-builder.js" webc:keep></script>

<style>
  :where(form) {
    --_border-color: light-dark(var(--color-7), var(--color-10));

    input,
    button,
    textarea {
      background-color: var(--surface-default);
    }

    input,
    textarea {
      border: 1px solid var(--_border-color);
      border-radius: 0.5rem;
      padding: 0.5em 0.75em;

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    select {
      border: 1px solid var(--_border-color);
      background-color: var(--surface-default);

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    > fieldset {
      border: 1px solid var(--border, var(--gray-8));
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      border-radius: var(--radius-2);

      legend {
        padding: 0 var(--size-1);
        font-weight: bold;
      }
    }

    #teams-input-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 10px;
      margin-bottom: 15px;
    }
  }
</style>
