<form>
  <div class="title-wrapper">
    <h2 class="form-mode-title">New competition</h2>
    <button
      type="button"
      commandfor="delete-confirm-modal"
      command="show-modal"
      class="delete-competition-btn hidden ui-button ui-tonal"
    >
      <span>🗑️</span> Delete
    </button>
  </div>
  <div class="form-error-banner"></div>

  <competition-meta></competition-meta>
  <syllabus-teams></syllabus-teams>
  <syllabus-fixtures></syllabus-fixtures>

  <div class="form-actions-container">
    <!-- Left Side: Task-Specific Operations -->
    <div class="task-actions">
      <button type="submit" class="ui-button ui-filled ui-primary">
        Save competition 💾
      </button>
      <button
        type="button"
        class="cancel-edit-btn hidden ui-button action-cancel ui-tonal"
      >
        Cancel Edits
      </button>
    </div>

    <!-- Right Side: Context Switcher -->
    <div class="context-actions">
      <button
        type="button"
        class="switch-to-create-btn action-create ui-button ui-filled"
      >
        Create New Competition
      </button>
    </div>
  </div>
</form>

<dialog
  id="delete-confirm-modal"
  class="ui-dialog ui-card ui-elevated"
  role="alertdialog"
  aria-labelledby="dialog-heading"
  aria-modal="true"
>
  <hgroup>
    <h2 id="dialog-heading" class="ui-h4">⚠️ Critical Warning</h2>
  </hgroup>
  <div class="ui-content">
    Are you completely sure you want to permanently delete this competition?
    This action cannot be undone.
  </div>
  <div class="ui-actions">
    <button
      commandfor="delete-confirm-modal"
      command="close"
      class="ui-button"
      type="button"
      value="cancel"
    >
      Cancel
    </button>
    <button
      commandfor="delete-confirm-modal"
      command="close"
      class="ui-button ui-filled"
      type="button"
      value="confirm"
    >
      Yes, Delete
    </button>
  </div>
</dialog>

<script type="module" src="/js/syllabus-builder.js" webc:keep></script>

<style>
  @layer components.extended {
    .ui-tonal.action-cancel {
      /* Light Mode: Super soft color tint
       Dark Mode: Deep, quiet charcoal/tint step (keeps luminance way down) */
      background-color: light-dark(var(--color-2), var(--color-2));

      /* Ensure the text contrast drops safely without being completely unreadable */
      color: light-dark(var(--color-12), var(--color-11));

      /* Smooth focus & hover states so it still feels responsive */
      &:hover {
        background-color: light-dark(var(--color-3), var(--color-3));
      }
    }
    .ui-filled.action-create {
      background-color: light-dark(var(--gray-11), var(--gray-4));
      color: light-dark(var(--gray-1), var(--gray-13));

      &:hover {
        background-color: light-dark(var(--gray-12), var(--gray-5));
      }
    }
  }

  :where(form) {
    --_border-color: light-dark(var(--color-7), var(--color-10));

    input,
    textarea {
      background-color: var(--surface-default);
    }

    input,
    textarea {
      border: 1px solid var(--_border-color);
      border-radius: 0.5rem;
      padding: 0.5em 0.75em;

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    select {
      border: 1px solid var(--_border-color);
      background-color: var(--surface-default);

      &:focus-visible {
        outline-color: var(--primary);
      }
    }
    .form-actions-container {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      width: 100%;
      margin-top: 20px;
    }

    .task-actions {
      display: grid;
      grid-auto-flow: column;
      gap: 10px;
      justify-content: start;
    }

    .context-actions {
      justify-self: end;
    }

    > fieldset {
      border: 1px solid var(--border, var(--gray-8));
      padding: var(--size-3);
      margin-bottom: var(--size-3);
      border-radius: var(--radius-2);

      legend {
        padding: 0 var(--size-1);
        font-weight: bold;
      }
    }

    .title-wrapper {
      display: flex;
      justify-content: space-between;
    }

    .hidden {
      display: none !important;
    }
  }
</style>
