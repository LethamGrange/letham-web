<style webc:bucket="syllabus">
  @layer components.features {
    :where(.competition-form) {
      --red: hsl(0, 66%, 54%);
      --_critical: var(--red);
      --_color: light-dark(var(--color-16), var(--color-1));
      --_color-contrast: light-dark(var(--color-1), var(--color-16));
      --_filled-hover-bg-color: oklch(from var(--primary) calc(l - 0.1) c h);
      --_border-color: light-dark(var(--color-7), var(--color-10));
      --_query-color: light-dark(var(--color-4), var(--color-12));

      color: var(--text-primary);
      font-size: var(--size-3);
      font-family: var(--ff-base, inherit);
      line-height: 1.6;
      border-radius: 1rem;
      margin: 0 auto;
      width: 100%; /* this needs structural width to give the container an intrinsic size */

      container-type: inline-size;

      h1,
      h2,
      p {
        margin-block: 0;
      }

      input,
      textarea {
        background-color: var(--surface-default);
      }
      .form-group {
        display: grid;
        grid-auto-rows: min-content;
      }
      fieldset:has([required]) legend,
      .form-group:has(:not([type="radio"])[required]) label {
        display: flex;
        gap: var(--size-2);

        &::after {
          content: "*";
          color: var(--text-muted, #71717a);
        }
      }
      fieldset {
        border: 0;
        padding: 0;

        display: grid;
        gap: var(--size-1) var(--size-3);
        grid-template-columns: inherit;
        .error-message {
          grid-column: 1 / -1;
        }
      }
      textarea {
        box-sizing: content-box;
        min-block-size: 3lh;
        resize: none;
        field-sizing: content;
      }

      input,
      textarea,
      .form-group:has(input[type="radio"]) {
        border: 1px solid var(--_border-color);
        border-radius: 0.5rem;
        padding: 0.5em 0.75em;

        &:focus-visible {
          outline-color: var(--primary);
        }
      }

      [type="radio"],
      [type="checkbox"] {
        width: var(--size-3);
        height: var(--size-3);
        margin: 0;
        flex-shrink: 0;
      }
      .form-group:has([type="radio"], [type="checkbox"]) {
        display: flex;
        gap: var(--size-2);
        align-items: center;
      }

      .form-group:has(input[type="radio"]) {
        border: 1px solid var(--_border-color);
        border-radius: 0.5rem;
        padding: 0.5em 0.75em;
        display: flex;
        gap: var(--size-2);
        align-items: center;
        position: relative;

        label::after {
          content: "";
          position: absolute;
          inset: 0;
          cursor: pointer;
        }
      }
      .form-group:has([type="radio"]:checked) {
        background: var(--_query-color);
        color: contrast-color(var(--_query-color));
        border-color: var(--_border-color);
      }

      .error-message {
        display: none;
        color: var(--_critical);
        font-size: var(--size-3);
      }

      fieldset:has([type="radio"][required]):has(:user-invalid) .error-message,
      .form-group:has([required]):has(:user-invalid) .error-message {
        display: block;
      }

      input:user-invalid,
      textarea:user-invalid {
        border-color: var(--red);
      }

      .form-group:has([type="checkbox"]) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.25rem var(--size-2);
        align-items: start;

        > input {
          grid-column: 1;
          grid-row: 1;
          margin-top: 0.25rem; /* Aligns box nicely with first text line */
        }

        > label {
          grid-column: 2;
          grid-row: 1;
        }

        .error-message {
          grid-column: 1 / -1;
          grid-row: 2;
        }
      }

      .span-all {
        grid-column: 1 / -1;
      }

      :where(competition-meta) {
        display: grid;
        gap: var(--size-3);

        span.help-message {
          font-size: var(--size-3);
          color: oklch(from var(--_color) calc(l - 0.2) c h);
        }

        @container (inline-size > 5000px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        button {
          background: var(--primary);
          color: var(--primary-contrast);

          border: 0;
          border-radius: var(--radius-2);
          padding: 0.75em 1.5em;

          &:hover,
          &:focus-visible {
            background: var(--_filled-hover-bg-color);
          }
        }
      }
    }
    .accordion-section {
      &[open] .accordion-header::before {
        transform: rotate(90deg);
      }

      /* This replaces the fieldset look cleanly */
      &.ui-card {
        background: var(--surface-default);
        border: 1px solid var(--border, var(--gray-8));
        border-radius: var(--radius-2, 8px);
        margin-bottom: var(--size-4, 16px);
        overflow: hidden; /* Prevents background color bleeding past corners */
      }

      /* Ensure content has padding only when the details section is open */
      &[open] .accordion-content {
        padding: var(--size-3, 12px);
        display: flex;
        flex-direction: column;
        gap: var(--size-3, 12px);
      }

      &[open] .compact-preview {
        display: none;
      }

      /* 2. Display the text cleanly ONLY when the accordion is closed */
      &:not([open]) .compact-preview {
        display: block;
        font-size: var(--font-size-0);
        color: var(--text-2);
        font-weight: normal;
      }

      /* Flex group for text and its counter */
      .title-group {
        display: flex;
        align-items: center;
        gap: var(--size-2, 8px);
      }

      .title-wrapper {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex-grow: 1; /* Pushes the "Add Team" button out to the far right side */
      }
    }

    /* Custom summary row using your Open Props setup */
    .accordion-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between; /* Pushes title-group and button apart */
      cursor: pointer;
      padding: var(--size-3, 12px);
      user-select: none;
      list-style: none;
    }

    .accordion-header::-webkit-details-marker {
      display: none;
    }

    /* Custom Marker */
    .accordion-header::before {
      content: "▶";
      font-size: 0.75em;
      display: inline-block;
      margin-top: 4px; /* Tiny adjustment to center the arrow vertically with just the text line */
      margin-right: var(--size-2, 8px);
      transition: transform 0.2s ease;
      color: var(--color-8);
      flex-shrink: 0; /* Prevents the arrow from squeezing if text wraps */
    }

    [popover] {
      /* 1. Reset standard center layout defaults */
      position: absolute;
      margin: 0;

      /* 2. Bind the popup to follow our transient anchor target name */
      position-anchor: --active-picker-target;

      /* 3. Natively align the top of the popover to the bottom of the button */
      top: anchor(bottom);
      left: anchor(left);

      /* Optional: Add your 4px offset space natively using CSS fallback math */
      margin-top: 4px;
    }
  }
</style>
