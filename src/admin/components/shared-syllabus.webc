<style webc:bucket="syllabus">
  @layer components.features {
    :where(.competition-form) {
      --red: hsl(0, 66%, 54%);
      --_critical: var(--red);
      --_color: light-dark(var(--color-16), var(--color-1));
      --_color-contrast: light-dark(var(--color-1), var(--color-16));
      --_filled-hover-bg-color: oklch(from var(--primary) calc(l - 0.1) c h);
      --_border-color: light-dark(var(--color-7), var(--color-10));
      --_query-color: light-dark(var(--color-4), var(--color-12));

      color: var(--text-primary);
      font-size: var(--size-3);
      font-family: var(--ff-base, inherit);
      line-height: 1.6;
      border-radius: 1rem;
      margin: 0 auto;
      width: 100%; /* this needs structural width to give the container an intrinsic size */

      container-type: inline-size;

      h1,
      h2,
      p {
        margin-block: 0;
      }

      input,
      textarea {
        background-color: var(--surface-default);
      }
      .form-group {
        display: grid;
        grid-auto-rows: min-content;
      }
      fieldset:has([required]) legend,
      .form-group:has(:not([type="radio"])[required]) label {
        display: flex;
        gap: var(--size-2);

        &::after {
          content: "*";
          color: var(--text-muted, #71717a);
        }
      }
      fieldset {
        border: 0;
        padding: 0;

        display: grid;
        gap: var(--size-1) var(--size-3);
        grid-template-columns: inherit;
        .error-message {
          grid-column: 1 / -1;
        }
      }
      textarea {
        box-sizing: content-box;
        min-block-size: 3lh;
        resize: none;
        field-sizing: content;
      }

      input,
      textarea,
      .form-group:has(input[type="radio"]) {
        border: 1px solid var(--_border-color);
        border-radius: 0.5rem;
        padding: 0.5em 0.75em;

        &:focus-visible {
          outline-color: var(--primary);
        }
      }

      [type="radio"],
      [type="checkbox"] {
        width: var(--size-3);
        height: var(--size-3);
        margin: 0;
        flex-shrink: 0;
      }
      .form-group:has([type="radio"], [type="checkbox"]) {
        display: flex;
        gap: var(--size-2);
        align-items: center;
      }

      .form-group:has(input[type="radio"]) {
        border: 1px solid var(--_border-color);
        border-radius: 0.5rem;
        padding: 0.5em 0.75em;
        display: flex;
        gap: var(--size-2);
        align-items: center;
        position: relative;

        label::after {
          content: "";
          position: absolute;
          inset: 0;
          cursor: pointer;
        }
      }
      .form-group:has([type="radio"]:checked) {
        background: var(--_query-color);
        color: contrast-color(var(--_query-color));
        border-color: var(--_border-color);
      }

      .error-message {
        display: none;
        color: var(--_critical);
        font-size: var(--size-3);
      }

      fieldset:has([type="radio"][required]):has(:user-invalid) .error-message,
      .form-group:has([required]):has(:user-invalid) .error-message {
        display: block;
      }

      input:user-invalid,
      textarea:user-invalid {
        border-color: var(--red);
      }

      .form-group:has([type="checkbox"]) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.25rem var(--size-2);
        align-items: start;

        > input {
          grid-column: 1;
          grid-row: 1;
          margin-top: 0.25rem; /* Aligns box nicely with first text line */
        }

        > label {
          grid-column: 2;
          grid-row: 1;
        }

        .error-message {
          grid-column: 1 / -1;
          grid-row: 2;
        }
      }

      .span-all {
        grid-column: 1 / -1;
      }

      :where(competition-meta) {
        display: grid;
        gap: var(--size-3);

        span.help-message {
          font-size: var(--size-3);
          color: oklch(from var(--_color) calc(l - 0.2) c h);
        }

        @container (inline-size > 5000px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        button {
          background: var(--primary);
          color: var(--primary-contrast);

          border: 0;
          border-radius: var(--radius-2);
          padding: 0.75em 1.5em;

          &:hover,
          &:focus-visible {
            background: var(--_filled-hover-bg-color);
          }
        }
      }
    }
  }
</style>
