<!-- ZONE 1: FIXED PARAMETERS -->
<fieldset class="competition-zone">
  <legend>1. Competition Details</legend>
  <input type="hidden" name="competition[id]" value="" />
  <div class="form-group">
    <label for="competition-name">Competition name</label>
    <input
      type="text"
      id="competition-name"
      name="competition[name]"
      required
      aria-describedby="competition-name-error"
      styleX="width: 250px"
    />

    <span class="error-message" id="competition-name-error" aria-live="polite">
      Competition name is required
    </span>
  </div>

  <div class="form-group">
    <label for="competition-kind">Format</label>
    <select
      class="ui-select"
      id="competition-kind"
      name="competition[kind]"
      required
      aria-describedby="competition-kind-error"
    >
      <option value="">-- Choose a kind --</option>
      <option value="league" selected>League</option>
      <option value="bonspiel">Bonspiel</option>
      <option value="friendly">Friendly</option>
    </select>

    <span class="error-message" id="competition-kind-error" aria-live="polite">
      Competition kind is required
    </span>
  </div>
  <div class="form-group">
    <label for="competition-reserves">Competition Reserves</label>
    <input
      type="text"
      id="competition-reserves"
      name="competition[reserves]"
      aria-describedby="competition-reserves-help"
      style="width: 100%"
    />

    <span
      class="help-message"
      id="competition-reserves-help"
      aria-live="polite"
    >
      Enter a comma-separated list of names (e.g. John Hall, Jackie Hall).
    </span>
  </div>
</fieldset>

<script type="module" src="/js/competition-meta.js" webc:keep></script>

<style>
  :where(fieldset.competition-zone) {
    --_border-color: light-dark(var(--color-7), var(--color-10));
    /* .form-group { */
    /*   display: flex; */
    /*   flex-direction: column; */
    /*   margin-bottom: var(--size-5); */
    /* } */
    /**/
    /* .form-group label { */
    /*   font-weight: var(--font-weight-6); */
    /*   margin-bottom: var(--size-2); */
    /*   color: var(--primary-text); */
    /* } */
    /**/
    /* .form-group input { */
    /*   padding: var(--size-2) var(--size-3); */
    /*   font-size: var(--font-size-1); */
    /*   border: var(--border-size-1) solid var(--gray-7); */
    /*   border-radius: var(--radius-2); */
    /*   background-color: var(--surface-default); */
    /*   color: var(--primary-text); */
    /* } */
    /**/
    /* /* The Helper Text configured for OPUI */
    /* .form-help { */
    /*   display: block; */
    /*   margin-top: var(--size-1); */
    /*   font-size: var(--font-size-0); */
    /*   line-height: var(--font-lineheight-2); */
    /**/
    /*   /* Uses a lighter gray that adapts naturally across themes */
    /*   color: var(--gray-11); */
    /* } */
    input,
    button,
    textarea {
      background-color: var(--surface-default);
    }

    input,
    textarea {
      border: 1px solid var(--_border-color);
      border-radius: 0.5rem;
      padding: 0.5em 0.75em;

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    select {
      border: 1px solid var(--_border-color);
      background-color: var(--surface-default);

      &:focus-visible {
        outline-color: var(--primary);
      }
    }

    border: 1px solid var(--border, var(--gray-8));
    padding: var(--size-3);
    margin-bottom: var(--size-3);
    border-radius: var(--radius-2);

    legend {
      padding: 0 var(--size-1);
      font-weight: bold;
    }
  }
</style>
