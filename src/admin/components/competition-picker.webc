<!-- components/competition-picker.webc -->
<div class="competition-picker" style="margin-top: var(--size-2)">
  <label for="competition_name">Competition / League:</label><br />
  <input
    type="text"
    id="competition_input"
    name="match[competition_name]"
    placeholder="e.g., Bank of Scotland, Spring League, Friendly..."
    list="canonical-leagues-list"
    required
    autocomplete="off"
    style="width: 100%"
  />
  <!-- 4. The Typo Hint div sits cleanly below the input for soft corrections -->
  <div
    class="typo-hint"
    style="min-height: var(--size-4); margin-top: var(--size-1)"
  ></div>
</div>

<datalist id="canonical-leagues-list">
  <option value="Bank of Scotland"></option>
  <option value="Contractor's Cup"></option>
  <option value="Spring League"></option>
  <option value="Mixed Doubles"></option>
</datalist>

<script src="/js/competition-picker.js" type="module" webc:keep></script>
<style>
  competition-picker {
    display: block;
    flex: 1; /* Instructs the parent flexbox to let this tag expand */
    min-width: 280px; /* Adjust based on your preferred design footprint */
  }

  /* 2. Clean up your internal wrapper layout */
  .competition-picker {
    width: 100%;
  }
</style>
