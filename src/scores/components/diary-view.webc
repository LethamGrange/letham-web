<div
  class="filter-bar"
  style="
    display: flex;
    gap: var(--size-2, 8px);
    align-items: center;
    margin-bottom: var(--size-4, 16px);
    flex-wrap: wrap;
  "
>
  <select class="filter-type-select" style="padding: var(--size-2)">
    <option value="all">All Entries</option>
    <option value="7days">This week</option>
    <option value="14days">Two weeks</option>
  </select>

  <!-- The Instant Download Trigger Button Element -->
  <button
    type="button"
    class="btn-pdf-download"
    style="
      padding: var(--size-2) var(--size-3);
      font-weight: 600;
      cursor: pointer;
      background: var(--primary);
      color: var(--primary-contrast);
      border: none;
      border-radius: var(--border-radius);
    "
  >
    📄 Share / Save PDF Diary
  </button>
</div>

<div class="diary-table-layout"></div>

<script src="/js/diary-view.js" type="module" webc:keep></script>

<style>
  .diary-table-layout {
    display: grid;
    /* Date, Time, Flexible Main Content, Tiny interaction footprint */
    grid-template-columns: minmax(100px, auto) minmax(80px, auto) 1fr;
    width: 100%;
    align-items: center;
    border-top: 1px solid var(--border-color, #ccc);
  }

  .diary-th {
    font-weight: 700;
    padding: 0.6rem 0.5rem;
    border-bottom: 2px solid var(--text-color, #000);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .diary-td {
    padding: 0.5rem;
    border-bottom: 1px solid var(--border-color, #e5e5e5);
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  /* Connects flawlessly with your text-wrap: pretty and font configurations */
  .diary-td > p {
    margin: 0;
  }

  .tick-column {
    justify-content: center;
  }

  .tick-column input[type="checkbox"] {
    width: 1.2rem;
    height: 1.2rem;
    cursor: pointer;
  }

  /* Optional styling hooks matching the colored badges on your paper syllabus sheets */
  .kind-league {
    border-left: 4px solid #3b82f6; /* Blue tint bar for League games */
    padding-left: calc(0.5rem - 4px);
  }
  .kind-bonspiel {
    border-left: 4px solid #eab308; /* Yellow/Gold tint bar for Bonspiels */
    padding-left: calc(0.5rem - 4px);
  }

  /* --- Core Structural Row Mapping Styles --- */
  .diary-td[data-kind] {
    border-bottom: var(--border-width, 1px) solid var(--border-color);
    padding: 0.5rem;

    /* Apply the dynamic background color tracking token */
    background-color: var(--row-bg, transparent);
    transition: background-color 0.2s ease;
  }

  /* --- Core Structural Row Mapping Styles --- */
  .diary-td[data-kind] {
    border-bottom: var(--border-width, 1px) solid var(--border-color);
    padding: 0.5rem;

    /*
    Dynamically applies the color values:
    Uses a crisp 92% Lightness on standard light mode screens,
    and drops to a comfortable 23% Lightness on dark mode surfaces.
  */
    background-color: light-dark(
      oklch(92% var(--row-chroma, 0.04) var(--row-hue, 0)),
      oklch(63% var(--row-chroma, 0.04) var(--row-hue, 0))
    );

    color: light-dark(var(--text-primary), var(--gray-15, #111111));
    transition: background-color 0.2s ease;
  }

  /* Ensure text inside paragraph blocks stays sharp and responsive */
  .diary-td[data-kind] > p {
    margin: 0;
    color: var(--text-primary);
  }

  /* --- Dynamic Syllabus Color Palette Mapping Matrix --- */

  /* 1. Bank of Scotland -> Light Blue (Hue 210) */
  .diary-td[data-kind="bank-of-scotland"] {
    --row-hue: 210;
    --row-chroma: 0.04;
  }

  /* 2. Contractors Cup -> Warm Amber Orange (Hue 75) */
  .diary-td[data-kind="contractors-cup"] {
    --row-hue: 84.58;
    --row-chroma: 0.1727;
  }

  /* 3. Super League -> Cyan Sea Blue (Hue 195) */
  .diary-td[data-kind="super-league"] {
    --row-hue: 233.6642;
    --row-chroma: 0.148581;
  }

  /* 4. Province and Area 12 -> Crimson Red (Hue 25) */
  .diary-td[data-kind="province-and-area-12-competitions"] {
    --row-hue: 29.2339;
    --row-chroma: 0.244572;
  }

  /* 5. Over 50's -> Bright Gold Yellow (Hue 100) */
  .diary-td[data-kind="over-50-s"] {
    --row-hue: 110;
    --row-chroma: 0.21;
  }

  /* 6. Inter-Club Games -> Muted Slate Blue (Hue 220) */
  .diary-td[data-kind="inter-club-games"] {
    --row-hue: 229;
    --row-chroma: 0.0435;
  }

  /* 7. FCCC Competitions -> Clean Neutral Gray (Chroma 0) */
  .diary-td[data-kind="fccc-competitions"] {
    --row-hue: 0;
    --row-chroma: 0;
  }

  /* 8. Agricar -> Mint Pasture Green (Hue 145) */
  .diary-td[data-kind="agricar"] {
    --row-hue: 137.39;
    --row-chroma: 0.0523;
  }

  /* 9. LGCC Competitions / Spring League -> Ice Silver Blue (Hue 230) */
  .diary-td[data-kind="lgcc-competitions-spring-league"] {
    --row-hue: 230;
    --row-chroma: 0.03;
  }

  /* 10. Ladies Games -> Lavender Pink (Hue 330) */
  .diary-td[data-kind="ladies-games"] {
    --row-hue: 330.65;
    --row-chroma: 0.0572;
  }

  /* --- Fallback / Generic Options --- */
  .diary-td[data-kind="generic-league"] {
    --row-hue: 140;
    --row-chroma: 0.02;
  }
  .diary-td[data-kind="generic-bonspiel"] {
    --row-hue: 80;
    --row-chroma: 0.02;
  }
  .diary-td[data-kind="default"] {
    background-color: var(--surface-default, transparent);
  }

  /* --- PRINT STYLESHEET OVERRIDES --- */
  @media print {
    /* 1. Strip away user interface controls and website wrapping chrome */
    header,
    footer,
    .filter-bar,
    site-nav,
    .btn-pdf-download {
      display: none !important;
    }

    /* 2. Force the main text elements to reset cleanly to crisp white backgrounds */
    body,
    main,
    .diary-table-layout {
      background: #ffffff !important;
      color: #000000 !important;
      box-shadow: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* 3. Keep the custom row pastels visible on the print tracking sheets */
    .diary-td[data-kind] {
      -webkit-print-color-adjust: exact; /* Crucial for WebKit/iOS safari conversions */
      print-color-adjust: exact; /* Guarantees row color hues map onto the PDF cells */
      border-bottom: 1px solid #cccccc !important;
    }

    .diary-td[data-kind] > p {
      color: #111111 !important;
    }

    /* 4. Prevent individual date records from splitting awkwardly across page breaks */
    .diary-td {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .diary-th {
      border-bottom: 2px solid #000000 !important;
      color: #000000 !important;
    }
  }
</style>
