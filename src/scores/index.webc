---
title: Scores
pagetitle: Letham Grange Curling
headerImage: /images/logo-high.png
headerAlt: Letham Grange logo
---

<h1 class="ui-h2">Recent Results Log</h1>
<!-- htmx will fetch and load existing scores here automatically when the page opens -->
<div
  id="recent-results"
  hx-get="/api/get-scores"
  hx-trigger="load"
  hx-swap="outerHTML"
>
  <div
    class="loading-placeholder"
    style="color: var(--text-3); padding: var(--size-3)"
  >
    Loading latest scorecards...
  </div>
</div>
<style>
  /* Anchor assignment bridge */
  .popover-trigger {
    anchor-name: var(--anchor-id);
    background: none;
    border: none;
    font-size: var(--font-size-3);
    cursor: pointer;
    padding: var(--size-1);
    line-height: 1;
    color: var(--text-2);
  }

  .popover-trigger:hover {
    color: var(--text-1);
  }

  /* Base structural layout for top-layer anchor element containers */
  [popover].popover-menu {
    display: none;
    position-anchor: var(--anchor-id);
    margin: 0;
    inset: auto;
    top: anchor(bottom);
    right: anchor(right);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-3);
    padding: var(--size-1);
    grid-template-columns: 1fr;
    row-gap: var(--size-1);
    min-width: 160px;
  }

  /* Activate CSS Grid structures natively when popover wakes */
  [popover].popover-menu:popover-open {
    display: grid;
  }

  /* Standardized row-item layout controls inside context layer */
  .popover-menu .popover-item {
    background: none;
    border: none;
    text-align: left;
    padding: var(--size-2) var(--size-3);
    cursor: pointer;
    font-weight: bold;
    font-size: var(--font-size-1);
    border-radius: var(--radius-1);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--size-2);
    align-items: center;
  }

  .popover-menu .popover-item:focus-visible {
    outline: 2px solid var(--brand);
  }

  /* Context Variations */
  .popover-menu .edit-action {
    color: var(--text-1);
  }

  .popover-menu .edit-action:hover {
    background: var(--surface-3);
  }

  .popover-menu .delete-action {
    color: var(--red-6);
  }

  .popover-menu .delete-action:hover {
    background: var(--red-1);
  }

  /* Semantic line separator controls */
  .popover-menu .popover-divider {
    border: 0;
    border-top: 1px solid var(--border);
    width: 100%;
    margin: 0;
  }
</style>
