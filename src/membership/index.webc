<h3 id="lgcc-fees">LGCC Membership fees 2026-27</h3>
<div class="fees-grid">
  <!-- Grid Headers -->
  <div class="fee-header"><p>Membership Category</p></div>
  <div class="fee-header numeric"><p>Fee</p></div>

  <!-- Row 1 -->
  <div class="fee-category"><p>Full Adult Member</p></div>
  <div class="fee-cost"><p>£50</p></div>

  <!-- Row 2 -->
  <div class="fee-category">
    <p>Adult Playing Member whose Mother Club is not Letham Grange (*)</p>
  </div>
  <div class="fee-cost"><p>£20</p></div>

  <!-- Row 3 -->
  <div class="fee-category"><p>Non-playing Adult (N)</p></div>
  <div class="fee-cost"><p>£15</p></div>

  <!-- Row 4 -->
  <div class="fee-category"><p>Junior (Y) 18–21 years</p></div>
  <div class="fee-cost"><p>£15</p></div>

  <!-- Row 5 -->
  <div class="fee-category"><p>Junior (J) under 18 years</p></div>
  <div class="fee-cost"><p>£15</p></div>

  <!-- Row 6 -->
  <div class="fee-category"><p>Gateway Club Members</p></div>
  <div class="fee-cost"><p>£15</p></div>
</div>
<p>
  Note: If subscription is not received by 1st November, the member will be
  excluded from playing any further club or club-sponsored games until fees are
  paid in full.
</p>

