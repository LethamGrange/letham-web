{
  "include": [
    "src/**/*",
    "_data/**/*",
    "_config/**/*",
    "functions/**/*",
    "eleventy.config.js"
  ],
  "exclude": [
    "node_modules",
    "_site",
    ".wrangler"
  ],
  "compilerOptions": {
    "checkJs": false,
    "resolveJsonModule": true,
    "module": "NodeNext",
    "target": "es2022",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  }
}
