{
  "name": "letham-site",
  "type": "module",
  "version": "202607-1",
  "scripts": {
    "start": "eleventy --serve  --quiet",
    "serve": "serve -l 8080 _site",
    "debug": "eleventy --serve ",
    "preview": "eleventy && serve _site",
    "build": "eleventy",
    "fullclean": "del  './_site' './.cache'",
    "clean": "del  './_site/**/*' ",
    "dev:backend": "wrangler pages dev _site"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.12.0-beta.7",
    "@11ty/webc": "^0.12.0-beta.2",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.33.0",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "material-symbols": "^0.45.9",
    "open-props": "^1.7.23"
  },
  "devDependencies": {
    "browserslist": "^4.28.7",
    "del-cli": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "stylelint": "^17.14.1",
    "wrangler": "^4.114.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 100
        }
      }
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "workerd@1.20260815.1": true
  }
}
